<div id="landingContainer" class="" style="display: none;">
    <link rel="stylesheet" href="./assets/css/output.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <div id="layoutRoot" class="flex min-h-screen w-full relative fit-content flex-row-reverse">
        
        <style>
            :root {
                --primary: #451F21;
                --secondary: #F8BA59;
                --secondary-dark: #EB843B;
                --white: #FFFFFF;
            }

            .glass-sidebar {
                /* Refined sidebar gray: softer gradient and subtle inner highlight */
                background: linear-gradient(180deg, #0f1113, #151718);
                border-right: 1px solid rgba(255,255,255,0.035);
                box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
            }

            .glass-card {
                /* Polished non-glass card: subtle gradient, soft border and shadow */
                background: linear-gradient(180deg, #1b1b1b, #121212);
                border: 1px solid rgba(248, 186, 89, 0.035);
                transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
                border-radius: 0.75rem;
            }

            .glass-card:hover {
                background: linear-gradient(180deg, #222, #141414);
                border-color: rgba(248, 186, 89, 0.08);
                transform: translateY(-4px);
                box-shadow: 0 8px 22px rgba(0,0,0,0.55);
            }

            .instance-item {
                cursor: pointer;
                transition: all 0.2s ease;
                position: relative;
            }

            .instance-item.selected {
                background: linear-gradient(to right, rgba(255, 106, 26, 0.15), rgba(24, 24, 24, 0.6));
                border-left: 3px solid #F8BA59;
                border-color: rgba(248, 186, 89, 0.5);
            }

            .instance-item:hover:not(.selected) {
                background: rgba(255, 255, 255, 0.08);
                border-color: rgba(248, 186, 89, 0.3);
            }

            .instance-item:active {
                transform: scale(0.98);
            }

            .launch-btn {
                /* Cleaner launch button base used for small buttons (retry, etc.) */
                background: linear-gradient(135deg, #FF7A33, #F8BA59 60%);
                transition: transform 0.18s ease, box-shadow 0.18s ease;
                position: relative;
                overflow: hidden;
                box-shadow: 0 6px 18px rgba(0,0,0,0.45);
                border: 1px solid rgba(255,255,255,0.03);
            }

            .launch-btn::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                border-radius: 50%;
                background: rgba(255,255,255,0.08);
                transform: translate(-50%, -50%);
                transition: width 0.45s, height 0.45s;
            }

            .launch-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 26px rgba(0,0,0,0.5);
            }

            .launch-btn:active { transform: translateY(0); }

            .launch-btn:active::before { width: 220px; height: 220px; }

            /* Main large launch button tweaks (apply to both ID and class) */
            #launch_button, .launch-button {
                border-radius: 1rem;
                border: 1px solid rgba(248,186,89,0.12) !important;
                box-shadow: 0 10px 30px rgba(15,12,10,0.5);
                transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
            }

            #launch_button:hover, .launch-button:hover { transform: translateY(-4px); box-shadow: 0 18px 42px rgba(15,12,10,0.6); }

            #stop_button, .stop-button { border-radius: 1rem; border: 1px solid rgba(255,100,100,0.09) !important; }

            /* === ANIMATIONS AVEC VENDOR PREFIXES === */
            @-webkit-keyframes spin {
                from { -webkit-transform: rotate(0deg); transform: rotate(0deg); }
                to { -webkit-transform: rotate(360deg); transform: rotate(360deg); }
            }
            @-moz-keyframes spin {
                from { -moz-transform: rotate(0deg); transform: rotate(0deg); }
                to { -moz-transform: rotate(360deg); transform: rotate(360deg); }
            }
            @-o-keyframes spin {
                from { -o-transform: rotate(0deg); transform: rotate(0deg); }
                to { -o-transform: rotate(360deg); transform: rotate(360deg); }
            }
            @keyframes spin {
                from { -webkit-transform: rotate(0deg); -moz-transform: rotate(0deg); -o-transform: rotate(0deg); transform: rotate(0deg); }
                to { -webkit-transform: rotate(360deg); -moz-transform: rotate(360deg); -o-transform: rotate(360deg); transform: rotate(360deg); }
            }

            .animate-spin {
                -webkit-animation: spin 1s linear infinite;
                -moz-animation: spin 1s linear infinite;
                -o-animation: spin 1s linear infinite;
                animation: spin 1s linear infinite;
            }

            @-webkit-keyframes fadeIn {
                from { opacity: 0; -webkit-transform: translateY(10px); transform: translateY(10px); }
                to { opacity: 1; -webkit-transform: translateY(0); transform: translateY(0); }
            }
            @-moz-keyframes fadeIn {
                from { opacity: 0; -moz-transform: translateY(10px); transform: translateY(10px); }
                to { opacity: 1; -moz-transform: translateY(0); transform: translateY(0); }
            }
            @-o-keyframes fadeIn {
                from { opacity: 0; -o-transform: translateY(10px); transform: translateY(10px); }
                to { opacity: 1; -o-transform: translateY(0); transform: translateY(0); }
            }
            @keyframes fadeIn {
                from { opacity: 0; -webkit-transform: translateY(10px); -moz-transform: translateY(10px); -o-transform: translateY(10px); transform: translateY(10px); }
                to { opacity: 1; -webkit-transform: translateY(0); -moz-transform: translateY(0); -o-transform: translateY(0); transform: translateY(0); }
            }

            .fade-in {
                -webkit-animation: fadeIn 0.5s ease-out forwards;
                -moz-animation: fadeIn 0.5s ease-out forwards;
                -o-animation: fadeIn 0.5s ease-out forwards;
                animation: fadeIn 0.5s ease-out forwards;
            }

            @-webkit-keyframes slideUp {
                from { opacity: 0; -webkit-transform: translateY(20px); transform: translateY(20px); }
                to { opacity: 1; -webkit-transform: translateY(0); transform: translateY(0); }
            }
            @-moz-keyframes slideUp {
                from { opacity: 0; -moz-transform: translateY(20px); transform: translateY(20px); }
                to { opacity: 1; -moz-transform: translateY(0); transform: translateY(0); }
            }
            @-o-keyframes slideUp {
                from { opacity: 0; -o-transform: translateY(20px); transform: translateY(20px); }
                to { opacity: 1; -o-transform: translateY(0); transform: translateY(0); }
            }
            @keyframes slideUp {
                from { opacity: 0; -webkit-transform: translateY(20px); -moz-transform: translateY(20px); -o-transform: translateY(20px); transform: translateY(20px); }
                to { opacity: 1; -webkit-transform: translateY(0); -moz-transform: translateY(0); -o-transform: translateY(0); transform: translateY(0); }
            }

            .slide-up-anim {
                -webkit-animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                -moz-animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                -o-animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .progress-bar-container {
                /* Solid subtle background for progress areas */
                background: rgba(255, 255, 255, 0.03);
            }

            .progress-bar-fill {
                background: linear-gradient(90deg, #FF6A1A, #F8BA59, #FF6A1A);
                background-size: 200% 100%;
                transition: width 0.3s ease-out;
            }

            @-webkit-keyframes shimmer {
                0% { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }
            @-moz-keyframes shimmer {
                0% { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }
            @-o-keyframes shimmer {
                0% { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }
            @keyframes shimmer {
                0% { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }

            @-webkit-keyframes shimmer-slow {
                0% { -webkit-transform: translateX(-100%); transform: translateX(-100%); }
                100% { -webkit-transform: translateX(100%); transform: translateX(100%); }
            }
            @-moz-keyframes shimmer-slow {
                0% { -moz-transform: translateX(-100%); transform: translateX(-100%); }
                100% { -moz-transform: translateX(100%); transform: translateX(100%); }
            }
            @-o-keyframes shimmer-slow {
                0% { -o-transform: translateX(-100%); transform: translateX(-100%); }
                100% { -o-transform: translateX(100%); transform: translateX(100%); }
            }
            @keyframes shimmer-slow {
                0% { -webkit-transform: translateX(-100%); -moz-transform: translateX(-100%); -o-transform: translateX(-100%); transform: translateX(-100%); }
                100% { -webkit-transform: translateX(100%); -moz-transform: translateX(100%); -o-transform: translateX(100%); transform: translateX(100%); }
            }

            .animate-shimmer-slow {
                -webkit-animation: shimmer-slow 8s linear infinite;
                -moz-animation: shimmer-slow 8s linear infinite;
                -o-animation: shimmer-slow 8s linear infinite;
                animation: shimmer-slow 8s linear infinite;
            }

            @-webkit-keyframes gradient {
                0%, 100% { background-position: 0% 50%; }
                50% { background-position: 100% 50%; }
            }
            @-moz-keyframes gradient {
                0%, 100% { background-position: 0% 50%; }
                50% { background-position: 100% 50%; }
            }
            @-o-keyframes gradient {
                0%, 100% { background-position: 0% 50%; }
                50% { background-position: 100% 50%; }
            }
            @keyframes gradient {
                0%, 100% { background-position: 0% 50%; }
                50% { background-position: 100% 50%; }
            }

            .animate-gradient {
                -webkit-animation: gradient 5s ease infinite;
                -moz-animation: gradient 5s ease infinite;
                -o-animation: gradient 5s ease infinite;
                animation: gradient 5s ease infinite;
            }

            @-webkit-keyframes ping-slow {
                0% { -webkit-transform: scale(1); transform: scale(1); opacity: 0.8; }
                50% { -webkit-transform: scale(1.05); transform: scale(1.05); opacity: 0.4; }
                100% { -webkit-transform: scale(1.1); transform: scale(1.1); opacity: 0; }
            }
            @-moz-keyframes ping-slow {
                0% { -moz-transform: scale(1); transform: scale(1); opacity: 0.8; }
                50% { -moz-transform: scale(1.05); transform: scale(1.05); opacity: 0.4; }
                100% { -moz-transform: scale(1.1); transform: scale(1.1); opacity: 0; }
            }
            @-o-keyframes ping-slow {
                0% { -o-transform: scale(1); transform: scale(1); opacity: 0.8; }
                50% { -o-transform: scale(1.05); transform: scale(1.05); opacity: 0.4; }
                100% { -o-transform: scale(1.1); transform: scale(1.1); opacity: 0; }
            }
            @keyframes ping-slow {
                0% { -webkit-transform: scale(1); -moz-transform: scale(1); -o-transform: scale(1); transform: scale(1); opacity: 0.8; }
                50% { -webkit-transform: scale(1.05); -moz-transform: scale(1.05); -o-transform: scale(1.05); transform: scale(1.05); opacity: 0.4; }
                100% { -webkit-transform: scale(1.1); -moz-transform: scale(1.1); -o-transform: scale(1.1); transform: scale(1.1); opacity: 0; }
            }

            .animate-ping-slow {
                -webkit-animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
                -moz-animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
                -o-animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
                animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
            }

            @-webkit-keyframes slide {
                0% { background-position: 0 0; }
                100% { background-position: 40px 0; }
            }
            @-moz-keyframes slide {
                0% { background-position: 0 0; }
                100% { background-position: 40px 0; }
            }
            @-o-keyframes slide {
                0% { background-position: 0 0; }
                100% { background-position: 40px 0; }
            }
            @keyframes slide {
                0% { background-position: 0 0; }
                100% { background-position: 40px 0; }
            }

            .animate-slide {
                -webkit-animation: slide 1s linear infinite;
                -moz-animation: slide 1s linear infinite;
                -o-animation: slide 1s linear infinite;
                animation: slide 1s linear infinite;
            }

            .progress-bar-fill::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(255,255,255,0.05), rgba(255,255,255,0.15), rgba(255,255,255,0.05));
                background-size: 200% 100%;
                -webkit-animation: shimmer 2s linear infinite;
                -moz-animation: shimmer 2s linear infinite;
                -o-animation: shimmer 2s linear infinite;
                animation: shimmer 2s linear infinite;
            }

            /* Simplified card shadow (no glass inset highlight) */
            .glass-card {
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
            }

            /* Override any Tailwind backdrop-blur utility applied alongside cards in this file */
            .glass-card.backdrop-blur-2xl {
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
            }

            /* Slightly nicer avatar container */
            #avatarContainer {
                background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(248,186,89,0.03));
                border: 1px solid rgba(255,255,255,0.03);
            }

            @-webkit-keyframes glowPulse {
                0%, 100% { 
                    -webkit-box-shadow: 0 0 20px rgba(248, 186, 89, 0.4); 
                    box-shadow: 0 0 20px rgba(248, 186, 89, 0.4); 
                }
                50% { 
                    -webkit-box-shadow: 0 0 40px rgba(248, 186, 89, 0.7); 
                    box-shadow: 0 0 40px rgba(248, 186, 89, 0.7); 
                }
            }
            @-moz-keyframes glowPulse {
                0%, 100% { 
                    -moz-box-shadow: 0 0 20px rgba(248, 186, 89, 0.4); 
                    box-shadow: 0 0 20px rgba(248, 186, 89, 0.4); 
                }
                50% { 
                    -moz-box-shadow: 0 0 40px rgba(248, 186, 89, 0.7); 
                    box-shadow: 0 0 40px rgba(248, 186, 89, 0.7); 
                }
            }
            @-o-keyframes glowPulse {
                0%, 100% { 
                    box-shadow: 0 0 20px rgba(248, 186, 89, 0.4); 
                }
                50% { 
                    box-shadow: 0 0 40px rgba(248, 186, 89, 0.7); 
                }
            }
            @keyframes glowPulse {
                0%, 100% { 
                    -webkit-box-shadow: 0 0 20px rgba(248, 186, 89, 0.4);
                    -moz-box-shadow: 0 0 20px rgba(248, 186, 89, 0.4);
                    box-shadow: 0 0 20px rgba(248, 186, 89, 0.4); 
                }
                50% { 
                    -webkit-box-shadow: 0 0 40px rgba(248, 186, 89, 0.7);
                    -moz-box-shadow: 0 0 40px rgba(248, 186, 89, 0.7);
                    box-shadow: 0 0 40px rgba(248, 186, 89, 0.7); 
                }
            }

            .glow-pulse {
                -webkit-animation: glowPulse 2s ease-in-out infinite;
                -moz-animation: glowPulse 2s ease-in-out infinite;
                -o-animation: glowPulse 2s ease-in-out infinite;
                animation: glowPulse 2s ease-in-out infinite;
            }

            .news-hero-button {
                -webkit-transition: -webkit-transform 0.3s ease;
                -moz-transition: -moz-transform 0.3s ease;
                -o-transition: -o-transform 0.3s ease;
                transition: transform 0.3s ease;
            }

            .news-hero-button:hover {
                -webkit-transform: translateX(-50%) translateY(-5px) !important;
                -moz-transform: translateX(-50%) translateY(-5px) !important;
                -o-transform: translateX(-50%) translateY(-5px) !important;
                transform: translateX(-50%) translateY(-5px) !important;
            }

            .social-link {
                color: #ffffff;
                -webkit-transition: all 0.2s ease;
                -moz-transition: all 0.2s ease;
                -o-transition: all 0.2s ease;
                transition: all 0.2s ease;
                display: inline-block;
            }

            .social-link:hover {
                -webkit-transform: translateY(-2px);
                -moz-transform: translateY(-2px);
                -o-transform: translateY(-2px);
                transform: translateY(-2px);
            }

            .social-discord:hover { color: #5865F2; }
            .social-tiktok:hover { color: #000000; }
            .social-youtube:hover { color: #FF0000; }
            .social-x:hover { color: #1DA1F2; }

            /* Instance fade animations avec vendor prefixes */
            @-webkit-keyframes instanceFadeOut {
                0% { opacity: 1; -webkit-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
                100% { opacity: 0; -webkit-transform: translateY(-12px) scale(0.985); transform: translateY(-12px) scale(0.985); }
            }
            @-moz-keyframes instanceFadeOut {
                0% { opacity: 1; -moz-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
                100% { opacity: 0; -moz-transform: translateY(-12px) scale(0.985); transform: translateY(-12px) scale(0.985); }
            }
            @-o-keyframes instanceFadeOut {
                0% { opacity: 1; -o-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
                100% { opacity: 0; -o-transform: translateY(-12px) scale(0.985); transform: translateY(-12px) scale(0.985); }
            }
            @keyframes instanceFadeOut {
                0% { opacity: 1; -webkit-transform: translateY(0) scale(1); -moz-transform: translateY(0) scale(1); -o-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
                100% { opacity: 0; -webkit-transform: translateY(-12px) scale(0.985); -moz-transform: translateY(-12px) scale(0.985); -o-transform: translateY(-12px) scale(0.985); transform: translateY(-12px) scale(0.985); }
            }

            @-webkit-keyframes instanceFadeIn {
                0% { opacity: 0; -webkit-transform: translateY(12px) scale(0.985); transform: translateY(12px) scale(0.985); }
                100% { opacity: 1; -webkit-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
            }
            @-moz-keyframes instanceFadeIn {
                0% { opacity: 0; -moz-transform: translateY(12px) scale(0.985); transform: translateY(12px) scale(0.985); }
                100% { opacity: 1; -moz-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
            }
            @-o-keyframes instanceFadeIn {
                0% { opacity: 0; -o-transform: translateY(12px) scale(0.985); transform: translateY(12px) scale(0.985); }
                100% { opacity: 1; -o-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
            }
            @keyframes instanceFadeIn {
                0% { opacity: 0; -webkit-transform: translateY(12px) scale(0.985); -moz-transform: translateY(12px) scale(0.985); -o-transform: translateY(12px) scale(0.985); transform: translateY(12px) scale(0.985); }
                100% { opacity: 1; -webkit-transform: translateY(0) scale(1); -moz-transform: translateY(0) scale(1); -o-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
            }

            .instance-fade-out {
                -webkit-animation: instanceFadeOut 0.24s cubic-bezier(0.22, 1, 0.36, 1) forwards;
                -moz-animation: instanceFadeOut 0.24s cubic-bezier(0.22, 1, 0.36, 1) forwards;
                -o-animation: instanceFadeOut 0.24s cubic-bezier(0.22, 1, 0.36, 1) forwards;
                animation: instanceFadeOut 0.24s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            }

            .instance-fade-in {
                -webkit-animation: instanceFadeIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) forwards;
                -moz-animation: instanceFadeIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) forwards;
                -o-animation: instanceFadeIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) forwards;
                animation: instanceFadeIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            }

            /* Text layer pour smooth content swap */
            .text-layer {
                display: inline-block;
                vertical-align: middle;
                -webkit-will-change: transform, opacity;
                will-change: transform, opacity;
            }

            /* Sidebar position helpers
               - `.sidebar-left` and `.sidebar-right` are applied to the document body
                 by the small script below. The layout root (`#layoutRoot`) toggles
                 `flex-row-reverse` to move the sidebar visually. */
            .sidebar-left #layoutRoot { }
            .sidebar-right #layoutRoot { }

            /* When sidebar is on the left, show the selection border on the right
               so visual selection still reads naturally. */
            .sidebar-left .instance-item.selected {
                border-left: none;
                border-right: 3px solid var(--secondary);
            }

            .sidebar-left .instance-item:hover:not(.selected) {
                border-left: none;
                border-right-color: rgba(248,186,89,0.3);
            }

            /* Ensure default right-side visuals remain when sidebar on right */
            .sidebar-right .instance-item.selected {
                border-left-color: var(--secondary);
                border-right: none;
            }

            @media (prefers-reduced-motion: reduce) {
                * {
                    animation: none !important;
                    transition: none !important;
                }
            }

            /* Reusable button styles */
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
                border-radius: 0.75rem;
                padding: 0.6rem 1rem;
                font-weight: 700;
                cursor: pointer;
                transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease, background 0.18s ease;
                border: 1px solid rgba(255,255,255,0.04);
                background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
                color: #fff;
            }

            .btn:active { transform: translateY(0); }

            .btn:hover { transform: translateY(-3px); }

            .btn-ghost {
                background: transparent;
                border-color: rgba(255,255,255,0.06);
                box-shadow: none;
                padding: 0.625rem 0.9rem;
            }

            .btn-icon { padding: 0.5rem; border-radius: 0.75rem; }

            .btn-primary {
                background: linear-gradient(90deg, #FF6A1A, #F8BA59 60%);
                box-shadow: 0 8px 24px rgba(15,12,10,0.45);
                border-color: rgba(248,186,89,0.12);
            }

            .btn-danger {
                background: linear-gradient(90deg,#e74c3c,#c0392b);
                box-shadow: 0 8px 24px rgba(200,50,50,0.25);
                border-color: rgba(255,80,80,0.12);
            }

            .btn-lg { padding: 0.9rem 1.25rem; border-radius: 1rem; font-size: 1.05rem; }

            /* Color variants */
            .btn-accent {
                background: linear-gradient(90deg, rgba(248,186,89,0.95), rgba(255,138,66,0.95));
                border-color: rgba(248,186,89,0.14);
                box-shadow: 0 10px 26px rgba(248,186,89,0.08);
            }

            .btn-success {
                background: linear-gradient(90deg,#34d399,#10b981);
                border-color: rgba(16,185,129,0.12);
                box-shadow: 0 10px 26px rgba(16,185,129,0.06);
            }

            .btn-info {
                background: linear-gradient(90deg,#60a5fa,#3b82f6);
                border-color: rgba(59,130,246,0.12);
                box-shadow: 0 10px 26px rgba(59,130,246,0.06);
            }

            .btn-warning {
                background: linear-gradient(90deg,#f59e0b,#f97316);
                border-color: rgba(245,158,11,0.12);
                box-shadow: 0 10px 26px rgba(245,158,11,0.06);
            }

            /* Instance item specific color tweaks */
            .instance-item {
                background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.005));
