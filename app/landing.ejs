                    <script>
                        (function(){
                            var ytBtn = document.getElementById('ytViewBtn');
                            var container = document.querySelector('.relative.z-10') || document.body;
                            if(!ytBtn) return;

                            function buildModal(){
                                if(document.getElementById('ytModal')) return document.getElementById('ytModal');

                                var overlay = document.createElement('div');
                                overlay.id = 'ytModal';
                                overlay.className = 'fixed inset-0 z-60 flex items-center justify-center bg-black/70';
                                overlay.setAttribute('role','dialog');
                                overlay.setAttribute('aria-modal','true');

                                var wrapper = document.createElement('div');
                                wrapper.className = 'relative w-[min(900px,95%)] max-w-[900px] p-4';

                                var closeBtn = document.createElement('button');
                                closeBtn.id = 'ytModalClose';
                                closeBtn.className = 'absolute top-3 right-3 btn btn-ghost btn-icon';
                                closeBtn.setAttribute('aria-label','Fermer');
                                closeBtn.innerHTML = '<i class="bi bi-x-lg"></i>';

                                var playerWrap = document.createElement('div');
                                playerWrap.className = 'aspect-video rounded-lg overflow-hidden glass-card';

                                var iframe = document.createElement('iframe');
                                // Use the provided embed page and request autoplay — user click should allow autoplay
                                iframe.src = 'https://multigames-studio.fr/embed.html?autoplay=1';
                                iframe.frameBorder = '0';
                                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                                iframe.setAttribute('allowfullscreen','');
                                iframe.style.width = '100%';
                                iframe.style.height = '100%';
                                iframe.style.border = '0';

                                playerWrap.appendChild(iframe);
                                wrapper.appendChild(closeBtn);
                                wrapper.appendChild(playerWrap);
                                overlay.appendChild(wrapper);

                                container.appendChild(overlay);

                                // Fade in
                                overlay.style.opacity = '0';
                                overlay.style.transition = 'opacity 160ms ease';
                                setTimeout(function(){ overlay.style.opacity = '1'; }, 10);

                                // Handlers
                                closeBtn.addEventListener('click', closeModal);
                                overlay.addEventListener('click', function(e){ if(e.target === overlay) closeModal(); });
                                window.addEventListener('keydown', escHandler);
                                // Focus
                                closeBtn.focus();

                                return overlay;
                            }

                            function escHandler(e){ if(e.key === 'Escape') closeModal(); }

                            function closeModal(){
                                var overlay = document.getElementById('ytModal');
                                if(!overlay) return;
                                // stop playback by blanking iframe src before removal
                                var ifr = overlay.querySelector('iframe'); if(ifr) try{ ifr.src = 'about:blank'; }catch(e){}
                                overlay.style.opacity = '0';
                                window.removeEventListener('keydown', escHandler);
                                setTimeout(function(){ overlay.remove(); }, 180);
                            }

                            ytBtn.addEventListener('click', function(){
                                if(document.getElementById('ytModal')){
                                    closeModal();
                                } else {
                                    buildModal();
                                }
                            });
                        })();
                    </script>

