    <!-- Styles et scripts pour la nouvelle interface -->
    <style>
        /* Apparition douce du contenu principal */
        main .max-w-2xl {
            min-height: 1px;
        }

        .fade-in {
            opacity: 0;
            transform: translateY(4px);
        }

        /* News styles moved to partial: app/news.ejs */

        /* Boutons principaux : effet de survol doux et léger */
        .play-btn,
        .settings-btn,
        .w-14.h-14 {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .play-btn:hover {
            background: #F8BA59;
            color: #181818;
        }

        .settings-btn:hover,
        .w-14.h-14:hover {
            background: #F8BA59;
            color: #181818;
        }

        /* Animation sur le select d'instance */
        .instance-select {
            min-width: 1px;
        }

        .instance-select:focus {
            border-color: #F8BA59;
        }

        /* Animation sur le dot de statut serveur */
        .server-status-dot {
            width: 8px;
            height: 8px;
            display: inline-block;
            border-radius: 9999px;
        }

        /* Button glass style */
        .glass-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #FFFFFF;
            border-radius: 10px;
        }

        .glass-btn:hover {
            background: rgba(255, 255, 255, 0.10);
        }

        /* Modpack cards styles */
        .modpack-card {
            cursor: pointer;
        }

        .modpack-card:hover {
            opacity: 1 !important;
        }

        .modpack-card.selected {
            background: linear-gradient(to right, #f97316, #ea580c) !important;
        }

        .modpack-avatar {
            background: #92400e;
        }

        /* Latest news specific styling */
        .news-card.glass-global {
            background: rgba(24, 24, 24, 0.36);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .news-thumb {
            width: 140px;
            height: 84px;
            background-size: cover;
            background-position: center;
            border-radius: 8px;
            flex-shrink: 0;
        }

        .news-title {
            margin: 0;
        }

        .news-excerpt {
            margin: 0;
        }

        @keyframes shine {}

        /* --- ADDED: Animations CSS utilities --- */
        /* Place these rules near the other styles */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideRight {
            from {
                opacity: 0;
                transform: translateX(18px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes popIn {
            from {
                opacity: 0;
                transform: scale(.96) translateY(4px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .animate-fade {
            animation: fadeUp 520ms cubic-bezier(.2, .9, .2, 1) both;
        }

        .animate-slide-right {
            animation: slideRight 420ms cubic-bezier(.2, .9, .2, 1) both;
        }

        .animated-pop {
            animation: popIn 420ms cubic-bezier(.2, .9, .2, 1) both;
        }

        /* --- ADDED: Extra animations & polish --- */
        @keyframes float {
            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }

            100% {
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 106, 26, 0);
                transform: scale(1);
            }

            50% {
                box-shadow: 0 0 30px 8px rgba(248, 186, 89, 0.06);
                transform: scale(1.01);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 106, 26, 0);
                transform: scale(1);
            }
        }

        @keyframes progressShimmer {
            0% {
                background-position: -200% 0;
            }

            100% {
                background-position: 200% 0;
            }
        }

        @keyframes wobble {
            0% {
                transform: rotate(0deg);
            }

            25% {
                transform: rotate(1deg);
            }

            75% {
                transform: rotate(-1deg);
            }

            100% {
                transform: rotate(0deg);
            }
        }

        /* Logo float */
        .logo-float {
            animation: float 6s ease-in-out infinite;
            will-change: transform;
        }

        /* Button hover pulse (non-intrusive) */
        .button-pulse {
            animation: pulse 1.6s ease-in-out infinite;
        }

        /* News card 3D tilt + hover lift */
        .news-card {
            transform-origin: center;
            transform-style: preserve-3d;
            transition: transform .22s cubic-bezier(.2, .9, .2, 1), box-shadow .22s ease;
            backface-visibility: hidden;
            will-change: transform;
        }

        .news-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
        }

        /* progress bar shimmer overlay */
        #launch_progress_bar::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.14) 50%, rgba(255, 255, 255, 0.05) 100%);
            background-size: 300% 100%;
            pointer-events: none;
            animation: progressShimmer 2.2s linear infinite;
            mix-blend-mode: overlay;
        }

        .glass-sidebar {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* small floating micro-anim for sidebar status dot */
        .glass-sidebar .status-dot-pulse {
            display: inline-block;
            animation: wobble 3s ease-in-out infinite;
        }

        /* stagger reveal utilities (intersection-based) */
        [data-reveal] {
            opacity: 0;
            transform: translateY(8px);
            transition: opacity .5s ease, transform .5s ease;
        }

        [data-reveal].revealed {
            opacity: 1;
            transform: translateY(0);
        }

        /* accessibility: respect reduced motion */
        /* --- Instance change animations --- */
        @keyframes instanceFadeOut {
            0% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-20px) scale(0.95);
            }
        }

        @keyframes instanceFadeIn {
            0% {
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes launchPulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 8px 24px rgba(248, 186, 89, 0.3);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 12px 32px rgba(248, 186, 89, 0.5);
            }
        }

        @keyframes slideUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes glowPulse {
            0%, 100% {
                box-shadow: 0 0 20px rgba(248, 186, 89, 0.4);
            }
            50% {
                box-shadow: 0 0 40px rgba(248, 186, 89, 0.7);
            }
        }

        /* Animation classes */
        .instance-fade-out {
            animation: instanceFadeOut 0.4s cubic-bezier(0.4, 0, 1, 1) forwards;
        }

        .instance-fade-in {
            animation: instanceFadeIn 0.5s cubic-bezier(0, 0, 0.2, 1) forwards;
        }

        .launch-pulse {
            animation: launchPulse 1.5s ease-in-out infinite;
        }

        .slide-up-anim {
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .glow-pulse {
            animation: glowPulse 2s ease-in-out infinite;
        }

        /* Stagger delays for smooth cascading */
        .server-title {
            animation-delay: 0.1s;
        }

        .server-desc {
            animation-delay: 0.2s;
        }

        .server-version {
            animation-delay: 0.3s;
        }

        .play-instance {
            animation-delay: 0.4s;
        }

        /* Launch button special effects */
        .play-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .play-btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .play-btn:active::before {
            width: 300px;
            height: 300px;
        }

        .play-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(248, 186, 89, 0.4);
        }

        .play-btn:active {
            transform: translateY(0);
        }

        /* Initial state for animations */
        .play-instance,
        #launch_details {
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        /* Hide launch details by default */
        #launch_details {
            opacity: 0;
            transform: translateY(20px);
        }

        /* Progress bar entrance animation */
        #launch_details.show {
            display: flex !important;
            
            opacity: 1;
        }

        /* Spinning animation for loading icon */
        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .animate-spin {
            animation: spin 1s linear infinite;
        }

        @media (prefers-reduced-motion: reduce) {

            .animate-fade,
            .animate-slide-right,
            .animated-pop,
            .logo-float,
            .button-pulse,
            .news-card,
            #launch_progress_bar::after,
            .instance-fade-out,
            .instance-fade-in,
            .launch-pulse,
            .slide-up-anim,
            .glow-pulse {
                animation: none !important;
                transition: none !important;
                transform: none !important;
            }
        }

        /* --- News fullscreen mode --- */
        /* When landingContainer has class in-news-mode, hide main UI and show only news fullscreen */
        #landingContainer.in-news-mode main,
        #landingContainer.in-news-mode aside {
            display: none !important;
        }

        /* Fullscreen news overlay (when visible) */
        #newsContainer.news-fullscreen {
            position: fixed;
            inset: 0;
            z-index: 80;
            background: linear-gradient(180deg, rgba(8, 8, 8, 0.98), rgba(8, 8, 8, 0.99));
            padding: 28px;
            overflow: auto;
            display: block !important;
        }

        /* Make the news grid narrower and centered in fullscreen */
        #newsContainer.news-fullscreen .news-grid {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* ...existing code... */
    </style>

    <script src="./assets/js/scripts/landing-inline.js"></script>
    <script src="./assets/js/scripts/landing.js"></script>
    <script src="./assets/js/scripts/news.js"></script>
