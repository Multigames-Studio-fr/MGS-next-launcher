        <!-- Scripts -->
        <script>
        (function(){
            function applySide(side){
                var root = document.getElementById('layoutRoot');
                var body = document.body;
                var btn = document.getElementById('toggleSidebarSideButton');
                if(!root) return;
                if(side === 'left'){
                    root.classList.remove('flex-row-reverse');
                    body.classList.add('sidebar-left');
                    body.classList.remove('sidebar-right');
                    if(btn) btn.innerHTML = '<i class="bi bi-layout-sidebar-inset-reverse text-lg"></i><span class="text-sm font-medium">Barre: Gauche</span>';
                    if(btn) btn.setAttribute('data-side','left');
                } else {
                    root.classList.add('flex-row-reverse');
                    body.classList.add('sidebar-right');
                    body.classList.remove('sidebar-left');
                    if(btn) btn.innerHTML = '<i class="bi bi-layout-sidebar-inset text-lg"></i><span class="text-sm font-medium">Barre: Droite</span>';
                    if(btn) btn.setAttribute('data-side','right');
                }
                try{ localStorage.setItem('sidebarSide', side); }catch(e){}
                try{
                    if(typeof window.forceValidateSelectedAccount === 'function'){
                        // Trigger a validation after user changes sidebar side (non-intrusive)
                        window.forceValidateSelectedAccount()
                    }
                }catch(e){}
            }

            function toggleSide(){
                var cur = 'right';
                try{ cur = localStorage.getItem('sidebarSide') || 'right'; }catch(e){}
                var next = cur === 'right' ? 'left' : 'right';
                applySide(next);
            }

            // Use event delegation so the handler survives DOM replacements.
            document.addEventListener('click', function(e){
                if(!e || !e.target) return;
                var btn = e.target.closest && e.target.closest('#toggleSidebarSideButton');
                if(btn){
                    e.preventDefault();
                    toggleSide();
                }
            });

            // Apply saved state on window load and re-apply shortly after to
            // handle other scripts that may modify the sidebar DOM.
            window.addEventListener('load', function(){
                var saved = 'right';
                try{ saved = localStorage.getItem('sidebarSide') || 'right'; }catch(e){}
                applySide(saved);
                setTimeout(function(){
                    try{ applySide(localStorage.getItem('sidebarSide') || saved); }catch(e){}
                }, 80);
            });

            // Observe DOM mutations to handle cases where other scripts replace
            // the sidebar content (which may recreate the toggle button). When
            // the toggle appears, reapply the saved side and update the button.
            try{
                var _sidebarObserver = new MutationObserver(function(mutations){
                    console.debug('[LANDING] Sidebar MutationObserver triggered', mutations && mutations.length)
                    var btn = document.getElementById('toggleSidebarSideButton');
                    // If the button doesn't exist, try to locate a replacement by heuristics
                    if(!btn){
                        try{
                            var candidates = Array.from(document.querySelectorAll('button, a'))
                            for(var i=0;i<candidates.length;i++){
                                var c = candidates[i]
                                var txt = (c.textContent||'').trim()
                                var hasIcon = false
                                try{ hasIcon = c.querySelector && (c.querySelector('.bi-layout-sidebar-inset') || c.querySelector('.bi-layout-sidebar-inset-reverse')) }catch(e){}
                                if(txt.indexOf('Barre:') !== -1 || hasIcon){
                                    c.id = c.id || 'toggleSidebarSideButton'
                                    c.setAttribute('aria-label', c.getAttribute('aria-label') || 'Position de la barre')
                                    btn = c
                                    console.debug('[LANDING] Reassigned toggleSidebarSideButton to candidate', c)
                                    break
                                }
                            }
                        }catch(e){ console.warn('[LANDING] Heuristic search failed', e) }
                    }

                    if(btn){
                        try{
                            var saved = localStorage.getItem('sidebarSide') || 'right';
                            applySide(saved);
                        }catch(e){ console.warn('[LANDING] applySide failed in observer', e) }
                    }
                });
                _sidebarObserver.observe(document.body, { childList: true, subtree: true });
            }catch(e){
                console.warn('[LANDING] Sidebar MutationObserver failed', e);
            }
        })();
        </script>
        <script src="./assets/js/scripts/landing-inline.js"></script>
        <script src="./assets/js/scripts/landing.js"></script>
        <script src="./assets/js/scripts/news.js"></script>
