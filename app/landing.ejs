        <style>
            :root {
                --primary: #451F21;
                --secondary: #F8BA59;
                --secondary-dark: #EB843B;
                --white: #FFFFFF;
            }

            /* Sidebar instances styling */
            .server-instance-item {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .server-instance-btn {
                background: none;
                border: none;
                cursor: pointer;
                border-radius: 0.75rem;
                display: flex;
                align-items: center;
            }

            /* Animated behavior for instance buttons (CSS-only solution) */
            .server-instance-btn {
                /* allow width transitions between Tailwind utility widths */
                box-sizing: border-box;
                transition-property: width, background-color, box-shadow, transform;
                transition-duration: 300ms;
                transition-timing-function: cubic-bezier(.2, .9, .2, 1);
                overflow: hidden;
                /* hide label overflow when shrinking */
                align-items: center;
                will-change: width, transform;
            }

            /* Explicit numeric widths to ensure smooth transitions between Tailwind classes */
            .server-instance-btn.w-20 {
                width: 5rem;
            }

            .server-instance-btn.w-64 {
                width: 16rem;
            }

            /* Icon micro-interaction: scale when the button is wide (selected by Tailwind w-64 class) */
            .server-instance-btn img {
                transition: transform 260ms cubic-bezier(.2, .9, .2, 1), box-shadow 260ms;
                will-change: transform;
            }

            .server-instance-btn.w-64 img {
                transform: scale(1.04);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
            }

            /* Animate the label even if it is toggled with Tailwind's 'hidden'/'block' classes.
               We override the display set by Tailwind with a more specific selector and animate
               opacity/transform/max-width for a smooth reveal without changing JS. */
            .server-instance-btn>div>span.font-semibold.text-xl.leading-tight {
                display: inline-block;
                /* override Tailwind 'hidden' display:none when necessary */
                opacity: 0;
                transform: translateX(-6px);
                max-width: 0;
                transition: opacity 220ms linear, transform 260ms cubic-bezier(.2, .9, .2, 1), max-width 260ms cubic-bezier(.2, .9, .2, 1);
                white-space: nowrap;
                vertical-align: middle;
                pointer-events: none;
            }

            .server-instance-btn>div>span.font-semibold.text-xl.leading-tight.block {
                opacity: 1;
                transform: translateX(0);
                max-width: 160px;
                /* matches the tailwind max width used in markup */
                pointer-events: auto;
            }

            .server-instance-btn>div>span.font-semibold.text-xl.leading-tight.hidden {
                opacity: 0;
                transform: translateX(-6px);
                max-width: 0;
                pointer-events: none;
            }

            /* Fix the player info area width so avatar/username layout doesn't shift during animations */
            .player-top-info {
                min-width: 12.5rem;
                /* fixed width for player info block */
                max-width: 12.5rem;
                box-sizing: border-box;
            }

            /* Respect reduced motion */
            @media (prefers-reduced-motion: reduce) {

                .server-instance-btn,
                .server-instance-btn>div>span.font-semibold.text-xl.leading-tight,
                .server-instance-btn img {
                    transition: none !important;
                }
            }
        </style>


