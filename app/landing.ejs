<div id="landingContainer" class="" style="display: none;">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="./assets/css/output.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <div id="layoutRoot" class="flex min-h-screen w-full relative fit-content flex-row-reverse">

        <style>
            /* === OVERRIDE DURÉE TRANSITIONS TAILWIND === */
            #landingContainer {
                --default-transition-duration: 0.3s;
            }

            /* === VARIABLES CSS === */
            :root {
                --primary: #451F21;
                --secondary: #F8BA59;
                --secondary-dark: #EB843B;
                --white: #FFFFFF;
            }

            /* === COMPOSANTS UI === */
            .glass-sidebar {
                background: linear-gradient(180deg, #0f1113, #151718);
                border-right: 1px solid rgba(255, 255, 255, 0.035);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
            }

            .glass-card {
                background: linear-gradient(180deg, #1b1b1b, #121212);
                border: 1px solid rgba(248, 186, 89, 0.035);
                border-radius: 0.75rem;
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
                transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, border-color 0.3s ease-out;
            }

            .glass-card:hover {
                background: linear-gradient(180deg, #222, #141414);
                border-color: rgba(248, 186, 89, 0.08);
                transform: translateY(-4px);
                box-shadow: 0 8px 22px rgba(0, 0, 0, 0.55);
            }

            .glass-card.backdrop-blur-2xl {
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
            }

            /* === ÉLÉMENTS D'INSTANCE === */
            .instance-item {
            
                cursor: pointer;
                background: linear-gradient(180deg, rgba(255, 255, 255, 0.01), rgba(255, 255, 255, 0.005));
                border-left: 3px solid transparent;
                transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, background 0.3s ease-out, border-color 0.3s ease-out;
            }

            .instance-item.selected {
                background: linear-gradient(90deg, rgba(255, 106, 26, 0.12), rgba(24, 24, 24, 0.6));
                border-left-color: var(--secondary);
                box-shadow: 0 10px 30px rgba(15, 12, 10, 0.45);
            }

            .instance-item:hover:not(.selected) {
                background: linear-gradient(90deg, rgba(255, 255, 255, 0.03), rgba(248, 186, 89, 0.02));
                border-color: rgba(248, 186, 89, 0.3);
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
            }

            .instance-item:active {
                transform: scale(0.98);
            }

            .instance-item .bi-check-circle-fill {
                color: var(--secondary);
            }

            /* === BOUTONS === */
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
                border-radius: 0.75rem;
                padding: 0.6rem 1rem;
                font-weight: 700;
                cursor: pointer;
                transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, opacity 0.3s ease-out, background 0.3s ease-out;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01));
                color: #fff;
            }

            .btn:active {
                transform: translateY(0);
            }

            .btn:hover {
                transform: translateY(-3px);
            }

            .btn:focus {
                outline: none;
                box-shadow: 0 0 0 4px rgba(248, 186, 89, 0.12), 0 6px 18px rgba(0, 0, 0, 0.45);
            }

            .btn-ghost {
                background: transparent;
                border-color: rgba(255, 255, 255, 0.06);
                box-shadow: none;
                padding: 0.625rem 0.9rem;
            }

            .btn-icon {
                padding: 0.5rem;
                border-radius: 0.75rem;
            }

            .btn-lg {
                padding: 0.9rem 1.25rem;
                border-radius: 1rem;
                font-size: 1.05rem;
            }

            /* === VARIANTS DE BOUTONS === */
            .btn-primary {
                background: linear-gradient(90deg, #FF6A1A, #F8BA59 60%);
                box-shadow: 0 8px 24px rgba(15, 12, 10, 0.45);
                border-color: rgba(248, 186, 89, 0.12);
            }

            .btn-danger {
                background: linear-gradient(90deg, #e74c3c, #c0392b);
                box-shadow: 0 8px 24px rgba(200, 50, 50, 0.25);
                border-color: rgba(255, 80, 80, 0.12);
            }

            .btn-accent {
                background: linear-gradient(90deg, rgba(248, 186, 89, 0.95), rgba(255, 138, 66, 0.95));
                border-color: rgba(248, 186, 89, 0.14);
                box-shadow: 0 10px 26px rgba(248, 186, 89, 0.08);
            }

            .btn-success {
                background: linear-gradient(90deg, #34d399, #10b981);
                border-color: rgba(16, 185, 129, 0.12);
                box-shadow: 0 10px 26px rgba(16, 185, 129, 0.06);
            }

            .btn-info {
                background: linear-gradient(90deg, #60a5fa, #3b82f6);
                border-color: rgba(59, 130, 246, 0.12);
                box-shadow: 0 10px 26px rgba(59, 130, 246, 0.06);
            }

            .btn-warning {
                background: linear-gradient(90deg, #f59e0b, #f97316);
                border-color: rgba(245, 158, 11, 0.12);
                box-shadow: 0 10px 26px rgba(245, 158, 11, 0.06);
            }

            /* === BOUTONS OUTLINE === */
            .btn-outline-primary {
                background: transparent;
                color: #FF6A1A;
                border: 1px solid rgba(255, 106, 26, 0.18);
            }

            .btn-outline-info {
                background: transparent;
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.14);
            }

            .btn-outline-success {
                background: transparent;
                color: #10b981;
                border: 1px solid rgba(16, 185, 129, 0.12);
            }

            /* === BOUTONS DE LANCEMENT === */
            .launch-btn {
                background: linear-gradient(135deg, #FF7A33, #F8BA59 60%);
                transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
                position: relative;
                overflow: hidden;
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
                border: 1px solid rgba(255, 255, 255, 0.03);
            }

            .launch-btn::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.08);
                transform: translate(-50%, -50%);
                transition: width 0.3s ease-out, height 0.3s ease-out;
            }

            .launch-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 26px rgba(0, 0, 0, 0.5);
            }

            .launch-btn:active {
                transform: translateY(0);
            }

            .launch-btn:active::before {
                width: 220px;
                height: 220px;
            }

            #launch_button,
            .launch-button {
                border-radius: 1rem;
                border: 1px solid rgba(248, 186, 89, 0.12) !important;
                box-shadow: 0 10px 30px rgba(15, 12, 10, 0.5);
                transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, opacity 0.3s ease-out;
            }

            #launch_button:hover,
            .launch-button:hover {
                transform: translateY(-4px);
                box-shadow: 0 18px 42px rgba(15, 12, 10, 0.6);
            }

            #stop_button,
            .stop-button {
                border-radius: 1rem;
                border: 1px solid rgba(255, 100, 100, 0.09) !important;
            }

            /* === ÉLÉMENTS SPÉCIAUX === */
            button,
            input[type="button"],
            input[type="submit"] {
                color: #fff;

                border: 1px solid rgba(255, 255, 255, 0.04);
            }

            button:focus,
            input[type="button"]:focus,
            input[type="submit"]:focus,
            a:focus {
                outline: none;
                box-shadow: 0 0 0 4px rgba(248, 186, 89, 0.12), 0 6px 18px rgba(0, 0, 0, 0.45);
            }

            #avatarContainer {
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(248, 186, 89, 0.03));

            }
            /* Wrapper and menu pour la sélection rapide de compte */
            .account-switch-wrapper {
                position: relative;
                display: inline-flex;
                align-items: center;
                /* Ensure the profile switch sits above instance elements */
                z-index: 2000;
                cursor: pointer;
                user-select: none;
                outline: none;
            }

            .account-menu {
                position: absolute;
                top: calc(100% + 0.5rem);
                right: 0;
                min-width: 220px;
                max-width: 320px;
                max-height: 260px;
                overflow-y: auto;
                /* Put the menu well above other UI layers (instances, sidebars) */
                z-index: 3000;
                padding: 0.25rem;
                border-radius: 0.5rem;
                background: rgb(20, 20, 20);
                border: 1px solid rgba(255,255,255,0.04);
                box-shadow: 0 10px 30px rgba(0,0,0,0.6);
                display: none;
            }

            .account-menu.visible { display: block; }

            .account-menu-item {
                display: flex;
                gap: 0.5rem;
                align-items: center;
                padding: 0.45rem;
                border-radius: 0.5rem;
                cursor: pointer;
            }

            .account-menu-item:hover {
                background: rgba(255,255,255,0.02);
            }

            .account-menu .no-accounts {
                padding: 0.6rem;
                color: #bfc7ce;
                text-align: center;
                font-size: 0.95rem;
            }

            /* === ANIMATIONS ET KEYFRAMES === */
            @keyframes spin {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }

            .animate-spin {
                animation: spin 1s linear infinite;
            }

            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .fade-in {
                animation: fadeIn 0.5s ease-out forwards;
            }

            @keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .slide-up-anim {
                animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            /* === BARRES DE PROGRESSION === */
            .progress-bar-container {
                background: rgba(255, 255, 255, 0.03);
            }

            .progress-bar-fill {
                background: linear-gradient(90deg, #FF6A1A, #F8BA59, #FF6A1A);
                background-size: 200% 100%;
                transition: width 0.3s ease-out;
            }

            @keyframes shimmer {
                0% {
                    background-position: 200% 0;
                }

                100% {
                    background-position: -200% 0;
                }
            }

            @keyframes shimmer-slow {
                0% {
                    transform: translateX(-100%);
                }

                100% {
                    transform: translateX(100%);
                }
            }

            .animate-shimmer-slow {
                animation: shimmer-slow 8s linear infinite;
            }

            @keyframes gradient {

                0%,
                100% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }
            }

            .animate-gradient {
                animation: gradient 5s ease infinite;
            }

            @keyframes ping-slow {
                0% {
                    transform: scale(1);
                    opacity: 0.8;
                }

                50% {
                    transform: scale(1.05);
                    opacity: 0.4;
                }

                100% {
                    transform: scale(1.1);
                    opacity: 0;
                }
            }

            .animate-ping-slow {
                animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
            }

            @keyframes slide {
                0% {
                    background-position: 0 0;
                }

                100% {
                    background-position: 40px 0;
                }
            }

            .animate-slide {
                animation: slide 1s linear infinite;
            }

            .progress-bar-fill::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05));
                background-size: 200% 100%;
                animation: shimmer 2s linear infinite;
            }



            @keyframes glowPulse {

                0%,
                100% {
                    box-shadow: 0 0 20px rgba(248, 186, 89, 0.4);
                }

                50% {
                    box-shadow: 0 0 40px rgba(248, 186, 89, 0.7);
                }
            }

            .glow-pulse {
                animation: glowPulse 2s ease-in-out infinite;
            }

            .news-hero-button {
                transition: transform 0.3s ease;
            }

            .news-hero-button:hover {
                transform: translateX(-50%) translateY(-5px) !important;
            }

            .social-link {
                color: #ffffff;
                transition: all 0.3s ease-out;
                display: inline-block;
            }

            .social-link:hover {
                transform: translateY(-2px);
            }

            .social-discord:hover {
                color: #5865F2;
            }

            .social-tiktok:hover {
                color: #000000;
            }

            .social-youtube:hover {
                color: #FF0000;
            }

            .social-x:hover {
                color: #1DA1F2;
            }

            @keyframes instanceFadeOut {
                0% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }

                100% {
                    opacity: 0;
                    transform: translateY(-12px) scale(0.985);
                }
            }

            @keyframes instanceFadeIn {
                0% {
                    opacity: 0;
                    transform: translateY(12px) scale(0.985);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .instance-fade-out {
                animation: instanceFadeOut 0.24s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            }

            .instance-fade-in {
                animation: instanceFadeIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            }

            /* === ANIMATIONS TEXTE CHANGEMENT INSTANCE === */
            @keyframes textFadeOut {
                0% {
                    opacity: 1;
                    transform: translateY(0);
                }
                100% {
                    opacity: 0;
                    transform: translateY(-10px);
                }
            }

            @keyframes textFadeIn {
                0% {
                    opacity: 0;
                    transform: translateY(10px);
                }
                100% {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .text-fade-out {
                animation: textFadeOut 0.2s ease-out forwards !important;
            }

            .text-fade-in {
                animation: textFadeIn 0.25s ease-out forwards !important;
            }

            /* === UTILITAIRES === */
            .text-layer {
                display: inline-block;
                vertical-align: middle;
                will-change: transform, opacity;
            }

            /* === SIDEBAR POSITIONING === */
            .sidebar-left #layoutRoot {}

            .sidebar-right #layoutRoot {}

            .sidebar-left .instance-item.selected {
                border-left: none;
                border-right: 3px solid var(--secondary);
            }

            .sidebar-left .instance-item:hover:not(.selected) {
                border-left: none;
                border-right-color: rgba(248, 186, 89, 0.3);
            }

            .sidebar-right .instance-item.selected {
                border-left-color: var(--secondary);
                border-right: none;
            }

            /* === STYLES DE LIENS === */
            a {
                color: var(--secondary);
                text-decoration: none;
                transition: color 0.3s ease-out, transform 0.3s ease-out;
            }

            a:hover,
            a:focus {
                color: #FF6A1A;
                text-decoration: underline;
                transform: translateY(-1px);
            }

            a.btn {
                display: inline-flex;
            }

            .link-accent::after {
                content: '';
                display: inline-block;
                width: 8px;
                height: 2px;
                background: linear-gradient(90deg, #FF6A1A, #F8BA59);
                margin-left: 8px;
                vertical-align: middle;
                border-radius: 2px;
            }

            /* === BADGES D'INSTANCE === */
            .instance-badge {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                display: inline-block;
                margin-left: 6px;
            }

            .instance-badge.pvp {
                background: linear-gradient(90deg, #ef4444, #f97316);
            }

            .instance-badge.rp {
                background: linear-gradient(90deg, #22c55e, #10b981);
            }

            .instance-badge.mod {
                background: linear-gradient(90deg, #3b82f6, #6366f1);
            }

            /* === ANIMATIONS DE LANCEMENT === */
            @keyframes launchPulse {
                0% {
                    transform: translateY(0) scale(1);
                    box-shadow: 0 10px 24px rgba(15, 12, 10, 0.35);
                }

                50% {
                    transform: translateY(-3px) scale(1.02);
                    box-shadow: 0 18px 36px rgba(15, 12, 10, 0.45);
                }

                100% {
                    transform: translateY(0) scale(1);
                    box-shadow: 0 10px 24px rgba(15, 12, 10, 0.35);
                }
            }

            @keyframes shineSlide {
                0% {
                    transform: translateX(-120%);
                }

                100% {
                    transform: translateX(120%);
                }
            }

            @keyframes progressStripe {
                0% {
                    background-position: 0 0;
                }

                100% {
                    background-position: 40px 0;
                }
            }

            #launch_button.is-launching,
            .launch-button.is-launching {
                animation: launchPulse 1.2s ease-in-out infinite !important;
            }

            #launch_button.is-launching::after,
            .launch-button.is-launching::after {
                content: '' !important;
                position: absolute !important;
                inset: 0 !important;
                background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.18) 50%, rgba(255, 255, 255, 0) 100%) !important;
                transform: translateX(-120%) !important;
                mix-blend-mode: overlay !important;
                pointer-events: none !important;
                animation: shineSlide 1.0s linear infinite !important;
                border-radius: inherit !important;
            }

            #launch_progress_bar,
            .launch-progress-bar {
                background-size: 200% 100% !important;
                background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.06) 100%) !important;
                animation: progressStripe 1s linear infinite !important;
            }

            #launch_progress_bar.active,
            .launch-progress-bar.active {
                box-shadow: 0 6px 18px rgba(248, 186, 89, 0.12) !important;
            }

            #launch_progress_bg {
                background: linear-gradient(90deg, rgba(255, 106, 26, 0.3) 0%, rgba(248, 186, 89, 0.4) 50%, rgba(255, 106, 26, 0.3) 100%) !important;
                background-size: 200% 100% !important;
                animation: progressStripe 2s linear infinite !important;
            }

            #launch_button.is-loading #launch_icon {
                animation: spin 1s linear infinite !important;
            }

            #launch_button.is-loading #launch_progress_bg {
                opacity: 1 !important;
            }

            #launch_button:not(.is-loading) #launch_progress_bg {
                opacity: 0 !important;
            }

            #launch_details_overlay {
                pointer-events: none;
                backdrop-filter: blur(2px);
            }

            #launch_progress_overlay {
                pointer-events: none;
            }

            /* === ÉTATS DU BOUTON LAUNCH === */
            #launch_button.is-loading .relative.z-10,
            #launch_button.is-launching .relative.z-10 {
                opacity: 0 !important;
                visibility: hidden !important;
            }

            #launch_button.is-loading #launch_details_overlay,
            #launch_button.is-launching #launch_details_overlay {
                opacity: 1 !important;
                visibility: visible !important;
            }

            #launch_button.is-loading #launch_progress_overlay,
            #launch_button.is-launching #launch_progress_overlay {
                opacity: 1 !important;
                visibility: visible !important;
            }

            #launch_button.is-loading #launch_progress_bar,
            #launch_button.is-launching #launch_progress_bar {
                opacity: 1 !important;
                visibility: visible !important;
                display: block !important;
            }

            /* === BOUTON STOP === */
            #stop_button {
                background: linear-gradient(90deg, #e74c3c, #c0392b) !important;
                border: 1px solid rgba(255, 100, 100, 0.2) !important;
                box-shadow: 0 8px 24px rgba(200, 50, 50, 0.35) !important;
            }

            #stop_button:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 30px rgba(200, 50, 50, 0.45) !important;
            }

            /* Contrôle explicite de l'affichage des boutons */
            #launch_button.btn-hidden {
                display: none !important;
            }

            /* Contrôles quand instances actives */
            #running_controls {
                display: none;
                flex-direction: row;
                gap: 0.5rem;
            }

            #running_controls.visible {
                display: flex !important;
            }

            #add_instance_button:disabled {
                opacity: 0.4;
                cursor: not-allowed;
                transform: none !important;
            }

            #add_instance_button:disabled:hover {
                transform: none !important;
                box-shadow: none !important;
            }

            #instance_counter.visible {
                display: block !important;
            }

            /* === LAUNCH DETAILS === */
            #launch_details {
                transition: opacity 0.3s ease, transform 0.3s ease;
            }

            #launch_details.show {
                opacity: 1 !important;
                transform: translateY(0) !important;
            }

            /* === BARRE DE PROGRESSION VISIBLE === */
            #launch_progress_bar {
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                background: linear-gradient(90deg, #FF6A1A, #F8BA59) !important;
                border-radius: inherit;
                z-index: 5;
            }

            /* === POSITIONNEMENT === */
            .main-left-center {
                position: absolute;
                left: 3.5rem;
                top: 50%;
                transform: translateY(-50%);
                z-index: 20;
                width: auto;
            }

            /* Positionner les stats en haut à gauche de la page */
            .stats-top-left {
                position: absolute;
                top: 1.75rem;
                /* proche du bord supérieur */
                left: 2rem;
                /* proche du bord gauche */

                display: flex;
                gap: 1rem;
                align-items: flex-start;
                padding: 0.25rem;
                border-radius: 0.75rem;
                background: rgba(6, 6, 6, 0.28);
                backdrop-filter: blur(6px);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
            }



            @media (max-width: 900px) {
                .main-left-center {
                    position: static;
                    transform: none;
                    max-width: none;
                    left: auto;
                    top: auto;
                }
            }

            /* === ANIMATIONS DÉCORATIVES === */
            @keyframes statusPulse {
                0%, 100% { opacity: 1; transform: scale(1); }
                50% { opacity: 0.7; transform: scale(1.2); }
            }

            @keyframes titleShimmer {
                0% { background-position: 0% center; }
                100% { background-position: 200% center; }
            }

            @keyframes floatSoft {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-2px); }
            }

            @keyframes buttonGlow {
                0%, 100% { box-shadow: 0 0 20px rgba(248, 186, 89, 0.3); }
                50% { box-shadow: 0 0 35px rgba(248, 186, 89, 0.5); }
            }

            @keyframes iconPulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.1); }
            }

            @keyframes slideInUp {
