        <style>
            :root {
                --primary: #451F21;
                --secondary: #F8BA59;
                --secondary-dark: #EB843B;
                --white: #FFFFFF;
            }

            /* Sidebar instances styling */
            .server-instance-item {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .server-instance-btn {
                background: none;
         
                cursor: pointer;
                 
                display: flex;
                align-items: center;
            }

            /* Animated behavior for instance buttons (CSS-only solution) */
            .server-instance-btn {
                /* allow width transitions between Tailwind utility widths */
                box-sizing:   -box;
                transition-property: width, background-color, box-shadow, transform;
                transition-duration: 300ms;
                transition-timing-function: cubic-bezier(.2, .9, .2, 1);
                overflow: hidden;
                /* hide label overflow when shrinking */
                align-items: center;
                will-change: width, transform;
            }

            /* Selection button animations (exit/enter) */
            .server-instance-btn.instance-btn-exit {
                animation: btnExit 0.22s cubic-bezier(.2,.9,.2,1) both;
            }

            .server-instance-btn.instance-btn-enter {
                animation: btnEnter 0.26s cubic-bezier(.2,.9,.2,1) both;
            }

            @keyframes btnExit {
                0% { transform: translateX(0) scale(1); opacity: 1; }
                100% { transform: translateX(-6px) scale(0.995); opacity: 0.95; }
            }

            @keyframes btnEnter {
                0% { transform: translateX(6px) scale(0.995); opacity: 0.95; }
                100% { transform: translateX(0) scale(1); opacity: 1; }
            }

            /* Explicit numeric widths to ensure smooth transitions between Tailwind classes */
            .server-instance-btn.w-20 {
                width: 5rem;
            }

            .server-instance-btn.w-64 {
                width: 16rem;
            }

            /* Icon micro-interaction: scale when the button is wide (selected by Tailwind w-64 class) */
            .server-instance-btn img {
                transition: transform 260ms cubic-bezier(.2, .9, .2, 1), box-shadow 260ms;
                will-change: transform;
            }

            .server-instance-btn.w-64 img {
                transform: scale(1.04);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
            }

            /* Animate the label even if it is toggled with Tailwind's 'hidden'/'block' classes.
               We override the display set by Tailwind with a more specific selector and animate
               opacity/transform/max-width for a smooth reveal without changing JS. */
            .server-instance-btn>div>span.font-semibold.text-xl.leading-tight {
                display: inline-block;
                /* override Tailwind 'hidden' display:none when necessary */
                opacity: 0;
                transform: translateX(-6px);
                max-width: 0;
                transition: opacity 220ms linear, transform 260ms cubic-bezier(.2, .9, .2, 1), max-width 260ms cubic-bezier(.2, .9, .2, 1);
                white-space: nowrap;
                vertical-align: middle;
                pointer-events: none;
            }

            /* Slide-label animation utilities (Style #2) */
            @keyframes labelSlideOut {
                0% { opacity: 1; transform: translateX(0); }
                100% { opacity: 0; transform: translateX(18px); }
            }

            @keyframes labelSlideIn {
                0% { opacity: 0; transform: translateX(-18px); }
                100% { opacity: 1; transform: translateX(0); }
            }

            .label-slide-out {
                display: inline-block !important;
                animation: labelSlideOut 0.22s cubic-bezier(.2,.9,.2,1) both;
            }

            .label-slide-in {
                display: inline-block !important;
                animation: labelSlideIn 0.26s cubic-bezier(.2,.9,.2,1) both;
            }

            /* Slight icon shift to accompany label sliding */
            .server-instance-btn.instance-btn-exit img {
                transform: translateX(-6px) scale(0.995);
            }

            .server-instance-btn.instance-btn-enter img {
                transform: translateX(6px) scale(1);
            }

            .server-instance-btn>div>span.font-semibold.text-xl.leading-tight.block {
                opacity: 1;
                transform: translateX(0);
                max-width: 160px;
                /* matches the tailwind max width used in markup */
                pointer-events: auto;
            }

            .server-instance-btn>div>span.font-semibold.text-xl.leading-tight.hidden {
                opacity: 0;
                transform: translateX(-6px);
                max-width: 0;
                pointer-events: none;
            }

            /* Fix the player info area width so avatar/username layout doesn't shift during animations */
            .player-top-info {
                min-width: 12.5rem;
                /* fixed width for player info block */
                max-width: 12.5rem;
                box-sizing:   -box;
            }

            /* Respect reduced motion */
            @media (prefers-reduced-motion: reduce) {

                .server-instance-btn,
                .server-instance-btn>div>span.font-semibold.text-xl.leading-tight,
                .server-instance-btn img {
                    transition: none !important;
                }
            }
        </style>


