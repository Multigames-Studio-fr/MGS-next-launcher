                },

                // États
                state: {
                    isLaunching: false,
                    isRunning: false,
                    progress: 0
                },

                // Initialisation
                init: function () {
                    this.elements.launchBtn = document.getElementById('launch_button');
                    this.elements.stopBtn = document.getElementById('stop_button');
                    this.elements.statusContainer = document.getElementById('launch_status');
                    this.elements.statusText = document.getElementById('launch_status_text');
                    this.elements.statusPercent = document.getElementById('launch_status_percent');
                    this.elements.statusBar = document.getElementById('launch_status_bar');
                    this.elements.launchIcon = document.getElementById('launch_button_icon');
                    this.elements.launchText = document.getElementById('launch_button_text');
                    this.elements.stopIcon = document.getElementById('stop_button_icon');
                    this.elements.stopText = document.getElementById('stop_button_text');

                    console.log('[LaunchUI] Initialized', this.elements);
                },

                // Afficher état: Prêt à lancer
                showReady: function () {
                    console.log('[LaunchUI] showReady');
                    this.state.isLaunching = false;
                    this.state.isRunning = false;

                    // Afficher bouton Lancer
                    if (this.elements.launchBtn) {
                        this.elements.launchBtn.classList.remove('hidden', 'btn-hidden');
                        this.elements.launchBtn.style.display = '';
                        this.elements.launchBtn.disabled = false;
                    }
                    if (this.elements.launchIcon) {
                        this.elements.launchIcon.className = 'bi bi-play-fill text-2xl';
                    }
                    if (this.elements.launchText) {
                        this.elements.launchText.textContent = 'Lancer';
                    }

                    // Cacher le conteneur running_controls
                    const runningControls = document.getElementById('running_controls');
                    if (runningControls) {
                        runningControls.classList.remove('visible');
                    }

                    // Cacher statut
                    if (this.elements.statusContainer) {
                        this.elements.statusContainer.classList.add('hidden');
                        this.elements.statusContainer.style.display = '';
                    }
                },

                // Afficher état: Téléchargement/Préparation
                showDownloading: function (text, percent) {
                    console.log('[LaunchUI] showDownloading', text, percent);
                    this.state.isLaunching = true;
                    this.state.progress = percent || 0;

                    // CACHER le bouton Lancer pendant le chargement
                    if (this.elements.launchBtn) {
                        this.elements.launchBtn.classList.add('hidden', 'btn-hidden');
                        this.elements.launchBtn.style.display = 'none';
                    }

                    // Cacher running_controls
                    const runningControls = document.getElementById('running_controls');
                    if (runningControls) {
                        runningControls.classList.remove('visible');
                    }

                    // Afficher statut de téléchargement
                    if (this.elements.statusContainer) {
                        this.elements.statusContainer.classList.remove('hidden');
                        this.elements.statusContainer.style.display = 'block';
                    }
                    if (this.elements.statusText) {
                        this.elements.statusText.textContent = text || 'Préparation...';
                    }
                    if (this.elements.statusPercent) {
                        this.elements.statusPercent.textContent = Math.round(percent || 0) + '%';
                    }
                    if (this.elements.statusBar) {
                        this.elements.statusBar.style.width = (percent || 0) + '%';
                    }
                },

                // Afficher état: Jeu en cours
                showRunning: function () {
                    console.log('[LaunchUI] showRunning - SHOWING STOP BUTTON');
                    this.state.isLaunching = false;
                    this.state.isRunning = true;

                    // CACHER le bouton Lancer
                    if (this.elements.launchBtn) {
                        this.elements.launchBtn.classList.add('hidden', 'btn-hidden');
                        this.elements.launchBtn.style.display = 'none';
                    }

                    // AFFICHER le conteneur running_controls (contient Stop + Add)
                    const runningControls = document.getElementById('running_controls');
                    if (runningControls) {
                        runningControls.classList.add('visible');
                        console.log('[LaunchUI] running_controls classList:', runningControls.classList.toString());
                    }

                    // S'assurer que le bouton Stop est actif
                    if (this.elements.stopBtn) {
                        this.elements.stopBtn.disabled = false;
                    }
                    if (this.elements.stopIcon) {
                        this.elements.stopIcon.className = 'bi bi-stop-fill text-2xl';
                    }
                    if (this.elements.stopText) {
                        this.elements.stopText.textContent = 'Arrêter';
                    }

                    // Cacher statut
                    if (this.elements.statusContainer) {
                        this.elements.statusContainer.classList.add('hidden');
                        this.elements.statusContainer.style.display = 'none';
                    }
                },

                // Afficher état: Arrêt en cours
                showStopping: function () {
                    console.log('[LaunchUI] showStopping');

                    if (this.elements.stopBtn) {
                        this.elements.stopBtn.disabled = true;
                    }
                    if (this.elements.stopIcon) {
                        this.elements.stopIcon.className = 'bi bi-hourglass-split text-2xl animate-spin';
                    }
                    if (this.elements.stopText) {
                        this.elements.stopText.textContent = 'Arrêt en cours...';
                    }
                },

                // Mettre à jour la progression
                updateProgress: function (percent, text) {
                    if (this.elements.statusPercent) {
                        this.elements.statusPercent.textContent = Math.round(percent) + '%';
                    }
                    if (this.elements.statusBar) {
                        this.elements.statusBar.style.width = percent + '%';
                    }
                    if (text && this.elements.statusText) {
                        this.elements.statusText.textContent = text;
                    }
                }
            };

            // Exposer globalement
            window.LaunchUI = LaunchUI;

            // Initialiser quand le DOM est prêt
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () {
                    LaunchUI.init();
                });
            } else {
                LaunchUI.init();
            }

            // Réinitialiser après un court délai (au cas où le DOM change)
            setTimeout(function () {
                LaunchUI.init();
            }, 500);

            // Écouter directement les changements d'état du jeu via IPC
            try {
                const { ipcRenderer } = require('electron');
                if (ipcRenderer) {
                    ipcRenderer.on('instance-state', (_, state) => {
                        console.log('[LaunchUI] Received instance-state via IPC:', state);
                        if (state && state.started === true) {
                            LaunchUI.showRunning();
                        } else if (state && state.started === false) {
                            LaunchUI.showReady();
                        } else if (state && state.starting === true) {
                            LaunchUI.showDownloading('Démarrage...', 0);
                        }
                    });
                }
            } catch (e) {
                console.warn('[LaunchUI] Could not setup IPC listener:', e);
            }
        })();
    </script>

    <script src="./assets/js/scripts/landing-inline.js"></script>
    <script src="./assets/js/scripts/landing.js"></script>
    <script src="./assets/js/scripts/news.js"></script>
    <script>
        (function () {
            'use strict';
            const btn = document.getElementById('switchAccountButton');
            const menu = document.getElementById('account_menu');
            const wrapper = document.querySelector('.account-switch-wrapper');

            function closeMenu() {
                if (!menu) return;
                menu.classList.remove('visible');
                menu.setAttribute('aria-hidden', 'true');
                menu.style.display = 'none';
            }

            function openMenu() {
                renderMenu();
                if (!menu) return;
                menu.classList.add('visible');
                menu.setAttribute('aria-hidden', 'false');
                menu.style.display = 'block';
            }

            function toggleMenu() {
                if (!menu) return;
                if (menu.classList.contains('visible')) closeMenu(); else openMenu();
            }

            function renderMenu() {
                if (!menu) return;
                menu.innerHTML = '';
                let accountsRaw = null;
                try {
                    if (window.ConfigManager && typeof window.ConfigManager.getAuthAccounts === 'function') {
                        accountsRaw = window.ConfigManager.getAuthAccounts();
                    } else {
                        console.warn('[ACCOUNT MENU] ConfigManager.getAuthAccounts not available');
                    }
                } catch (e) {
                    console.error('[ACCOUNT MENU] ERREUR lors de la lecture des comptes:', e);
                    accountsRaw = null;
                }

                console.log('[ACCOUNT MENU] ===== DIAGNOSTIC =====');
                console.log('[ACCOUNT MENU] accountsRaw type:', typeof accountsRaw);
                console.log('[ACCOUNT MENU] accountsRaw value:', accountsRaw);
                console.log('[ACCOUNT MENU] Is Array?', Array.isArray(accountsRaw));
                console.log('[ACCOUNT MENU] Keys:', accountsRaw && typeof accountsRaw === 'object' ? Object.keys(accountsRaw) : 'N/A');

                // Normaliser en tableau: ConfigManager peut renvoyer un tableau ou un objet map
                let accounts = [];
                if (Array.isArray(accountsRaw)) {
                    console.log('[ACCOUNT MENU] Format: ARRAY');
                    accounts = accountsRaw;
                } else if (accountsRaw && typeof accountsRaw === 'object') {
                    console.log('[ACCOUNT MENU] Format: OBJECT → converting to array');
                    accounts = Object.values(accountsRaw);
                } else {
                    console.log('[ACCOUNT MENU] Format: UNKNOWN/NULL');
                    accounts = [];
                }

                console.log('[ACCOUNT MENU] Comptes après normalisation:', accounts.length, 'items');
                console.log('[ACCOUNT MENU] Contenu des comptes:', accounts);

                // Filter to only show standard launcher account types (avoid showing other clients)
                const allowedTypes = ['microsoft', 'mojang'];
                const filtered = (accounts || []).filter(a => {
                    const isValid = a && (a.type || '').toLowerCase();
                    const isAllowed = allowedTypes.indexOf(isValid) !== -1;
                    if (!isValid) console.log('[ACCOUNT MENU] Compte sans type:', a);
                    if (!isAllowed) console.log('[ACCOUNT MENU] Type non autorisé:', a.type);
                    return isAllowed;
                });

                console.log('[ACCOUNT MENU] Comptes après filtrage:', filtered.length, 'items');
                console.log('[ACCOUNT MENU] Comptes filtrés:', filtered);

                // If no accounts found yet, try a few short retries because
                // `ConfigManager` may be merged asynchronously from sql storage.
                // Increased to 20 retries @ 100ms = 2 second window for async load
                menu._retryCount = menu._retryCount || 0;
                if ((!filtered || filtered.length === 0) && menu._retryCount < 20) {
                    console.debug('[ACCOUNT MENU] Aucun compte trouvé, retry', menu._retryCount, 'of 20');
                    menu._retryCount++;
                    setTimeout(renderMenu, 100);
                    // show temporary message while waiting
                    menu.innerHTML = '<div class="no-accounts">Chargement des comptes... (' + menu._retryCount + '/20)</div>';
                    return;
                }

                if (!filtered || filtered.length === 0) {
                    console.error('[ACCOUNT MENU] ❌ AUCUN COMPTE TROUVÉ APRÈS 20 RETRIES');
                    menu.innerHTML = '<div class="no-accounts">Aucun compte trouvé<br><button id="refreshAccountsBtn" class="btn btn-ghost btn-icon" title="Recharger" style="margin-top:8px;padding:4px;font-size:0.9rem"><i class="bi bi-arrow-clockwise text-sm"></i> Recharger</button></div>';
                    const refreshBtn = menu.querySelector('#refreshAccountsBtn');
                    if (refreshBtn) {
                        refreshBtn.addEventListener('click', function(e) {
                            e.stopPropagation();
                            menu._retryCount = 0;
                            renderMenu();
                        });
                    }
                    return;
                }

                console.log('[ACCOUNT MENU] ✅ Affichage de', filtered.length, 'compte(s)');

                const selectedUuid = (window.ConfigManager && typeof window.ConfigManager.getSelectedAccount === 'function') ? window.ConfigManager.getSelectedAccount() : null;

                filtered.forEach(function (acc) {
                    const uuid = acc && (acc.uuid || acc.id || acc.clientId || '') || '';
                    const item = document.createElement('div');
                    item.className = 'account-menu-item';
                    item.tabIndex = 0;
                    const avatarHtml = (acc && acc.avatar) ? '<img src="' + (acc.avatar || '') + '" alt="" style="width:100%;height:100%;object-fit:cover">' : '<i class="bi bi-person-fill text-lg"></i>';
                    const displayName = acc && (acc.displayName || acc.username || acc.name || 'Compte');
                    const meta = acc && (acc.type || '');
                    const isSelected = selectedUuid && selectedUuid === uuid;

                    item.innerHTML = '<div style="width:36px;height:36px;border-radius:8px;overflow:hidden;background:rgba(255,255,255,0.03);display:flex;align-items:center;justify-content:center">' + avatarHtml + '</div>' +
                        '<div style="flex:1;min-width:0;margin-left:6px"><div style="color:#fff;font-size:0.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + displayName + '</div><div style="color:#9aa6b2;font-size:0.78rem">' + meta + '</div></div>' +
                        '<div style="margin-left:6px">' + (isSelected ? '<i class="bi bi-check-circle-fill text-yellow-400" title="Sélectionné"></i>' : '<button class="btn btn-ghost btn-icon select-account" title="Sélectionner"><i class="bi bi-check-lg"></i></button>') + '</div>';

                    const selectBtn = item.querySelector('.select-account');
                    if (selectBtn) {
                        selectBtn.addEventListener('click', function (ev) {
                            ev.stopPropagation();
                            try {
                                if (window.ConfigManager && typeof window.ConfigManager.setSelectedAccount === 'function') {
                                    window.ConfigManager.setSelectedAccount(uuid);
                                    if (typeof window.ConfigManager.save === 'function') window.ConfigManager.save();
                                }
                                if (typeof window.updateSelectedAccount === 'function') window.updateSelectedAccount(acc);
                            } catch (e) {
                                console.warn('[ACCOUNT MENU] select error', e);
                            }
                            closeMenu();
                        });
                    }

                    item.addEventListener('click', function () { if (selectBtn) selectBtn.click(); });
                    menu.appendChild(item);
                });
            }

            // Close when clicking outside
            document.addEventListener('click', function (e) {
                if (!menu) return;
                if (e.target.closest && (e.target.closest('#account_menu') || e.target.closest('#switchAccountButton'))) return;
                if (menu.classList.contains('visible')) closeMenu();
            });

            // Attendre que ConfigManager soit disponible (peut prendre 1-2 secondes)
            function waitForConfigManager(maxWait = 20) {
                return new Promise(function(resolve) {
                    if (window.ConfigManager && typeof window.ConfigManager.getAuthAccounts === 'function') {
                        console.log('[ACCOUNT MENU] ✅ ConfigManager déjà disponible');
                        resolve(true);
                        return;
                    }
                    
                    let attempts = 0;
                    const interval = setInterval(function() {
                        attempts++;
                        if (window.ConfigManager && typeof window.ConfigManager.getAuthAccounts === 'function') {
                            console.log('[ACCOUNT MENU] ✅ ConfigManager disponible après', attempts * 100, 'ms');
                            clearInterval(interval);
                            resolve(true);
                        } else if (attempts >= maxWait) {
                            console.error('[ACCOUNT MENU] ❌ Timeout: ConfigManager non disponible après', maxWait * 100, 'ms');
                            clearInterval(interval);
                            resolve(false);
                        }
                    }, 100);
                });
            }

            // Wrapper pour ouvrir le menu avec vérification ConfigManager
            async function safeOpenMenu() {
                if (!menu) return;
                menu.classList.add('visible');
                menu.setAttribute('aria-hidden', 'false');
                menu.style.display = 'block';
                menu.innerHTML = '<div class="no-accounts">Chargement des comptes...</div>';
                
                const isReady = await waitForConfigManager(50); // 50 * 100ms = 5 secondes max
                
                if (isReady) {
                    renderMenu();
                } else {
                    menu.innerHTML = '<div class="no-accounts">Erreur: impossible de charger les comptes<br><button id="refreshAccountsBtn" class="btn btn-ghost btn-icon" title="Recharger" style="margin-top:8px;padding:4px;font-size:0.9rem"><i class="bi bi-arrow-clockwise text-sm"></i> Recharger</button></div>';
                    const refreshBtn = menu.querySelector('#refreshAccountsBtn');
                    if (refreshBtn) {
                        refreshBtn.addEventListener('click', function(e) {
                            e.stopPropagation();
                            closeMenu();
                            safeOpenMenu();
                        });
                    }
                }
            }

            if (btn) btn.addEventListener('click', function (e) { 
                e.preventDefault(); 
                e.stopPropagation(); 
                if (menu && menu.classList.contains('visible')) {
                    closeMenu();
                } else {
                    safeOpenMenu();
                }
            });

            // Make the whole wrapper toggle the account menu
            if (wrapper) {
                // ensure keyboard accessibility
                try { wrapper.setAttribute('tabindex', '0'); } catch (e) { }
                wrapper.addEventListener('click', function (e) {
                    // if the click target is the menu itself or a control inside it, ignore
                    if (e.target && e.target.closest && e.target.closest('#account_menu')) return;
                    // if the click target is the settings/other buttons inside, allow their handlers
                    if (e.target && e.target.closest && e.target.closest('#switchAccountButton')) return;
                    e.preventDefault();
                    e.stopPropagation();
                    if (menu && menu.classList.contains('visible')) closeMenu(); else safeOpenMenu();
                });
                wrapper.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        if (menu && menu.classList.contains('visible')) closeMenu(); else safeOpenMenu();
                    }
                });
            }

            // Expose helpers
            window.openAccountMenu = safeOpenMenu;
            window.closeAccountMenu = closeMenu;
        })();
    </script>
</div>