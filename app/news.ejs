<!-- News View: Style cohérent avec landing.ejs -->
<section id="newsContainer" class="hidden" style="display: none;">
    <link rel="stylesheet" href="./assets/css/output.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        /* === VARIABLES CSS === */
        :root {
            --primary: #451F21;
            --secondary: #F8BA59;
            --secondary-dark: #EB843B;
            --white: #FFFFFF;
        }

        /* === STYLES NEWS === */
        #newsContainer {
            background: linear-gradient(135deg, #0a0a0a 0%, #111111 50%, #0d0d0d 100%);
            min-height: 100vh;
            width: 100%;
        }

        .news-header {
            background: linear-gradient(180deg, rgba(15, 17, 19, 0.95), rgba(21, 23, 24, 0.9));
            border-bottom: 1px solid rgba(255, 255, 255, 0.035);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .news-card {
            background: linear-gradient(180deg, #1b1b1b, #121212);
            border: 1px solid rgba(248, 186, 89, 0.035);
            border-radius: 1rem;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
            transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, border-color 0.3s ease-out;
            overflow: hidden;
        }

        .news-card:hover {
            background: linear-gradient(180deg, #222, #141414);
            border-color: rgba(248, 186, 89, 0.12);
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
        }

        .news-card-featured {
            background: linear-gradient(180deg, #1f1f1f, #151515);
            border: 1px solid rgba(248, 186, 89, 0.08);
        }

        .news-card-featured:hover {
            border-color: rgba(248, 186, 89, 0.2);
            box-shadow: 0 16px 40px rgba(248, 186, 89, 0.08);
        }

        .btn-news {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            border-radius: 0.75rem;
            padding: 0.6rem 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, background 0.3s ease-out;
            border: 1px solid rgba(255, 255, 255, 0.04);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01));
            color: #fff;
        }

        .btn-news:hover {
            transform: translateY(-2px);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
        }

        .btn-news-primary {
            background: linear-gradient(90deg, #FF6A1A, #F8BA59 60%);
            box-shadow: 0 6px 18px rgba(255, 106, 26, 0.25);
            border-color: rgba(248, 186, 89, 0.12);
        }

        .btn-news-primary:hover {
            box-shadow: 0 8px 24px rgba(255, 106, 26, 0.35);
        }

        .btn-news-back {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .btn-news-back:hover {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
            border-color: rgba(255, 255, 255, 0.1);
        }

        .category-badge {
            background: linear-gradient(90deg, rgba(248, 186, 89, 0.15), rgba(255, 138, 66, 0.1));
            border: 1px solid rgba(248, 186, 89, 0.2);
            color: #F8BA59;
        }

        .category-badge-event {
            background: linear-gradient(90deg, rgba(139, 92, 246, 0.15), rgba(167, 139, 250, 0.1));
            border-color: rgba(139, 92, 246, 0.2);
            color: #A78BFA;
        }

        .category-badge-update {
            background: linear-gradient(90deg, rgba(34, 197, 94, 0.15), rgba(74, 222, 128, 0.1));
            border-color: rgba(34, 197, 94, 0.2);
            color: #4ADE80;
        }

        .category-badge-community {
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.15), rgba(96, 165, 250, 0.1));
            border-color: rgba(59, 130, 246, 0.2);
            color: #60A5FA;
        }

        /* Scrollbar personnalisée */
        #newsContainer::-webkit-scrollbar {
            width: 8px;
        }

        #newsContainer::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }

        #newsContainer::-webkit-scrollbar-thumb {
            background: rgba(248, 186, 89, 0.3);
            border-radius: 4px;
        }

        #newsContainer::-webkit-scrollbar-thumb:hover {
            background: rgba(248, 186, 89, 0.5);
        }

        /* Animation skeleton */
        .skeleton {
            background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.05), rgba(255,255,255,0.02));
            background-size: 200% 100%;
            animation: skeleton-shimmer 1.5s ease-in-out infinite;
        }

        @keyframes skeleton-shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* Animation fade in */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .news-card-animated {
            animation: fadeInUp 0.4s ease-out forwards;
        }

        .news-card-animated:nth-child(1) { animation-delay: 0.05s; }
        .news-card-animated:nth-child(2) { animation-delay: 0.1s; }
        .news-card-animated:nth-child(3) { animation-delay: 0.15s; }
        .news-card-animated:nth-child(4) { animation-delay: 0.2s; }
        .news-card-animated:nth-child(5) { animation-delay: 0.25s; }
        .news-card-animated:nth-child(6) { animation-delay: 0.3s; }
    </style>

    <!-- Contenu principal -->
    <div class="flex flex-col min-h-screen w-full overflow-y-auto">
        
        <!-- Header fixe -->
        <header class="news-header sticky top-0 z-50 px-6 py-4">
            <div class="max-w-7xl mx-auto flex items-center justify-between">
                <!-- Gauche: Bouton retour + Titre -->
                <div class="flex items-center gap-4">
                    <button id="newsBackButton" class="btn-news btn-news-back group">
                        <i class="bi bi-arrow-left text-lg transition-transform group-hover:-translate-x-1"></i>
                        <span class="hidden sm:inline">Retour</span>
                    </button>
                    
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-lg shadow-amber-500/20">
                            <i class="bi bi-newspaper text-white text-lg"></i>
                        </div>
                        <div>
                            <h1 class="text-xl font-bold text-white">Actualités</h1>
                            <p class="text-xs text-gray-500">MultiGames Studio</p>
                        </div>
                    </div>
                </div>

                <!-- Droite: Actions -->
                <div class="flex items-center gap-3">
                    <button id="newsRefreshButton" class="btn-news refresh-news group" title="Rafraîchir">
                        <i class="bi bi-arrow-clockwise text-lg transition-transform group-hover:rotate-180 duration-500"></i>
                        <span class="hidden sm:inline">Rafraîchir</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Zone de contenu -->
        <main class="flex-1 px-6 py-8">
            <div class="max-w-7xl mx-auto">

                <!-- Container d'erreur (inclut chargement, erreur, vide) -->
                <div id="newsErrorContainer">
                    <!-- État de chargement -->
                    <div id="newsErrorLoading" class="flex flex-col items-center justify-center py-20">
                        <div class="relative mb-6">
                            <div class="w-16 h-16 rounded-full border-4 border-gray-800 border-t-amber-500 animate-spin"></div>
                            <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-amber-500/10 to-transparent animate-pulse"></div>
                        </div>
                        <p id="nELoadSpan" class="text-white font-medium"><%- lang('landing.newsErrorLoadSpan') %></p>
                        <p class="text-gray-500 text-sm mt-1">Veuillez patienter</p>
                    </div>

                    <!-- État d'erreur -->
                    <div id="newsErrorFailed" class="hidden flex-col items-center justify-center py-20">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-red-600/20 to-red-700/10 flex items-center justify-center mb-6 border border-red-500/20">
                            <i class="bi bi-exclamation-triangle text-red-500 text-3xl"></i>
                        </div>
                        <p id="nEFailedSpan" class="text-white font-medium text-lg"><%- lang('landing.newsErrorFailedSpan') %></p>
                        <p class="text-gray-500 text-sm mt-2 mb-6">Vérifiez votre connexion internet</p>
                        <button id="newsErrorRetry" class="btn-news btn-news-primary">
                            <i class="bi bi-arrow-clockwise"></i>
                            <%- lang('landing.newsErrorRetryButton') %>
                        </button>
                    </div>

                    <!-- État aucune actualité -->
                    <div id="newsErrorNone" class="hidden flex-col items-center justify-center py-20">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gray-700/50 to-gray-800/30 flex items-center justify-center mb-6 border border-gray-700/50">
                            <i class="bi bi-inbox text-gray-500 text-3xl"></i>
                        </div>
                        <p id="nENoneSpan" class="text-white font-medium text-lg"><%- lang('landing.newsErrorNoneSpan') %></p>
                        <p class="text-gray-500 text-sm mt-2">Revenez plus tard pour voir les nouveautés</p>
                    </div>
                </div>

                <!-- Contenu des actualités -->
                <div id="newsContent" class="hidden">
                    
                    <!-- Article en vedette -->
                    <section id="newsFeaturedSection" class="mb-10 hidden">
                        <div class="flex items-center gap-3 mb-4">
                            <i class="bi bi-star-fill text-amber-500"></i>
                            <h2 class="text-lg font-bold text-white">En vedette</h2>
                        </div>
                        <div id="newsFeaturedStrip" class="flex gap-4 overflow-x-auto pb-2 scroll-smooth snap-x snap-mandatory">
                            <!-- Les articles en vedette seront injectés ici -->
                        </div>
                    </section>

                    <!-- Grille des actualités -->
                    <section>
                        <div class="flex items-center gap-3 mb-6">
                            <i class="bi bi-grid-3x3-gap-fill text-gray-500"></i>
                            <h2 class="text-lg font-bold text-white">Toutes les actualités</h2>
                            <span id="newsCount" class="text-xs text-gray-500 bg-gray-800 px-2 py-1 rounded-full">0</span>
                        </div>
                        
                        <div id="newsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" aria-live="polite">
                            <!-- Les cartes seront injectées ici -->
                        </div>
                    </section>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="px-6 py-4 border-t border-white/5 mt-auto">
            <div class="max-w-7xl mx-auto flex items-center justify-between text-xs text-gray-600">
                <span>© 2026 MultiGames Studio</span>
                <a href="https://multigames-studio.fr" target="_blank" class="hover:text-amber-500 transition-colors">
                    multigames-studio.fr
                </a>
            </div>
        </footer>
    </div>

    <!-- Template pour carte d'actualité -->
    <template id="news-card-template">
        <article class="news-card news-card-animated cursor-pointer group opacity-0" role="article" tabindex="0">
            <!-- Image -->
            <div class="news-image relative h-44 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900"></div>
                <img src="" alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                
                <!-- Badge catégorie -->
                <div class="absolute top-3 left-3">
                    <span class="news-category-badge category-badge text-xs font-semibold px-2.5 py-1 rounded-lg">
                        Actualité
                    </span>
                </div>
            </div>
            
            <!-- Contenu -->
            <div class="news-content p-4">
                <h3 class="news-title-stacked font-bold text-white text-base leading-tight mb-2 line-clamp-2 group-hover:text-amber-400 transition-colors">
                    Titre de l'actualité
                </h3>
                
                <p class="news-excerpt-stacked text-gray-400 text-sm line-clamp-2 mb-4">
                    Description de l'actualité...
                </p>
                
                <!-- Footer carte -->
                <div class="flex items-center justify-between pt-3 border-t border-white/5">
                    <div class="news-date flex items-center gap-2 text-gray-500 text-xs">
                        <i class="bi bi-calendar3"></i>
                        <span class="news-date-day">--</span>
                        <span class="news-date-month">---</span>
                    </div>
                    
                    <div class="flex items-center gap-3">
                        <div class="news-views flex items-center gap-1 text-gray-500 text-xs">
                            <i class="bi bi-eye"></i>
                            <span class="news-view-count">0</span>
                        </div>
                        
                        <button class="news-open-button text-xs font-semibold text-amber-500 hover:text-amber-400 transition-colors flex items-center gap-1">
                            Lire
                            <i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </article>
    </template>

    <!-- Template pour carte en vedette -->
    <template id="news-featured-template">
        <a class="news-featured-card news-card news-card-featured min-w-[300px] min-h-[180px] cursor-pointer group flex-shrink-0 snap-start overflow-hidden" 
           role="article" 
           tabindex="0">
            <div class="relative h-full">
                <!-- Image de fond -->
                <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900"></div>
                <img src="" alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                
                <!-- Badge -->
                <div class="absolute top-3 left-3">
                    <span class="news-featured-category category-badge text-xs font-semibold px-2.5 py-1 rounded-lg flex items-center gap-1.5">
                        <i class="bi bi-star-fill text-amber-400 text-[10px]"></i>
                        <span>En vedette</span>
                    </span>
                </div>
                
                <!-- Contenu -->
                <div class="absolute bottom-0 left-0 right-0 p-4">
                    <h4 class="news-featured-title font-bold text-white text-lg leading-tight line-clamp-2 group-hover:text-amber-400 transition-colors">
                        Titre
                    </h4>
                    <p class="news-featured-summary text-gray-300 text-sm mt-2 line-clamp-2">
                        Résumé
                    </p>
                </div>
            </div>
        </a>
    </template>
</section>

<script>
    // Script pour le bouton retour et refresh
    (function() {
        const backBtn = document.getElementById('newsBackButton');
        if (backBtn) {
            backBtn.addEventListener('click', function(e) {
                e.preventDefault();
                // Retourner à la page landing
                if (typeof switchView === 'function' && typeof getCurrentView === 'function') {
                    switchView(getCurrentView(), '#landingContainer');
                } else if (typeof window.switchView === 'function' && typeof window.getCurrentView === 'function') {
                    window.switchView(window.getCurrentView(), '#landingContainer');
                } else {
                    // Fallback
                    const newsContainer = document.getElementById('newsContainer');
                    const landingContainer = document.getElementById('landingContainer');
                    if (newsContainer) {
                        newsContainer.classList.add('hidden');
                        newsContainer.style.display = 'none';
                    }
                    if (landingContainer) {
                        landingContainer.classList.remove('hidden');
                        landingContainer.style.display = '';
                    }
                }
            });
        }

        // Bouton refresh
        const refreshBtn = document.getElementById('newsRefreshButton');
        const retryBtn = document.getElementById('newsErrorRetry');
        
        function refreshNews() {
            if (typeof window.initNews === 'function') {
                try { window.initNews(true); } catch(e) { console.warn('initNews error', e); }
            }
        }

        if (refreshBtn) {
            refreshBtn.addEventListener('click', refreshNews);
        }
        if (retryBtn) {
            retryBtn.addEventListener('click', refreshNews);
        }

        // Mise à jour du compteur de news
        const observer = new MutationObserver(function(mutations) {
            const newsGrid = document.getElementById('newsGrid');
            const newsCount = document.getElementById('newsCount');
            if (newsGrid && newsCount) {
                const count = newsGrid.querySelectorAll('.news-card').length;
                newsCount.textContent = count;
            }
        });

        const newsGrid = document.getElementById('newsGrid');
        if (newsGrid) {
            observer.observe(newsGrid, { childList: true });
        }
    })();
</script>
