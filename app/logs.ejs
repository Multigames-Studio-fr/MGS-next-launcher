<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%= lang('logs.title') %></title>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'"> 
    <style>
        html,body{height:100%;margin:0;background:#0b0b0b;color:#e6e6e6;font-family:system-ui,Segoe UI,Roboto,'Helvetica Neue',Arial}
        #toolbar{height:40px;padding:6px;display:flex;gap:8px;align-items:center;background:#111}
        #controls button{padding:6px 10px;background:#1f1f1f;border:1px solid #2b2b2b;color:#e6e6e6;border-radius:4px}
        #logbox{padding:12px;height:calc(100% - 52px);overflow:auto;white-space:pre-wrap;font-family:monospace;font-size:12px;background:#090909}
    </style>
</head>
<body>
    <div id="toolbar">
        <div id="controls">
            <button id="clearBtn"><%= lang('logs.clear') %></button>
            <button id="pauseBtn"><%= lang('logs.pause') %></button>
            <button id="saveBtn"><%= lang('logs.save') %></button>
        </div>
        <div style="flex:1"></div>
        <div id="status"><%= lang('logs.statusReady') %></div>
    </div>
    <div id="logbox"></div>

    <script src="./assets/js/logs-window.js"></script>
</body>
</html>