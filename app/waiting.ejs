<div id="waitingContainer" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-6">
    <div id="waitingContent"
        class="w-full max-w-md bg-[#0b0b0b]/88 rounded-2xl p-6 md:p-8 flex flex-col items-center text-center shadow-2xl mx-auto">
        <!-- Spinner -->
        <div class="loader">
            <div class="loader-square"></div>
            <div class="loader-square"></div>
            <div class="loader-square"></div>
            <div class="loader-square"></div>
            <div class="loader-square"></div>
            <div class="loader-square"></div>
            <div class="loader-square"></div>
        </div>

        <!-- Texte d'attente (conserver ID) -->
        <div id="waitingTextContainer">
            <h2 class="text-lg md:text-xl font-semibold text-white mb-1"><%- lang('waiting.waitingText') %></h2>
            <p class="text-sm text-white/70">Veuillez patienter pendant la préparation...</p>
        </div>

        <!-- Optionnel: petit footer ou hint -->
        <div class="mt-4 text-xs text-white/50">Si cela prend trop de temps, vérifiez votre connexion ou relancez le
            launcher.</div>
    </div>
    <style>
        @keyframes square-animation {
            0% {
                left: 0;
                top: 0;
            }

            10.5% {
                left: 0;
                top: 0;
            }

            12.5% {
                left: 22px;
                top: 0;
            }

            23% {
                left: 22px;
                top: 0;
            }

            25% {
                left: 44px;
                top: 0;
            }

            35.5% {
                left: 44px;
                top: 0;
            }

            37.5% {
                left: 44px;
                top: 22px;
            }

            48% {
                left: 44px;
                top: 22px;
            }

            50% {
                left: 22px;
                top: 22px;
            }

            60.5% {
                left: 22px;
                top: 22px;
            }

            62.5% {
                left: 22px;
                top: 44px;
            }

            73% {
                left: 22px;
                top: 44px;
            }

            75% {
                left: 0;
                top: 44px;
            }

            85.5% {
                left: 0;
                top: 44px;
            }

            87.5% {
                left: 0;
                top: 22px;
            }

            98% {
                left: 0;
                top: 22px;
            }

            100% {
                left: 0;
                top: 0;
            }
        }

        .loader {
            position: relative;
            /* placed inside .center so use flow positioning */
            display: inline-block;
            width: 64px;
            height: 64px;
            transform: rotate(45deg);
            margin-top: 12px;
            /* small spacing under logo/status */
        }

        .loader-square {
            position: absolute;
            top: 0;
            left: 0;
            width: 20px;
            height: 20px;
            margin: 1px;
            border-radius: 0px;
            background: white;
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            animation: square-animation 10s ease-in-out infinite both;
        }

        .loader-square:nth-of-type(0) {
            animation-delay: 0s;
        }

        .loader-square:nth-of-type(1) {
            animation-delay: -1.4285714286s;
        }

        .loader-square:nth-of-type(2) {
            animation-delay: -2.8571428571s;
        }

        .loader-square:nth-of-type(3) {
            animation-delay: -4.2857142857s;
        }

        .loader-square:nth-of-type(4) {
            animation-delay: -5.7142857143s;
        }

        .loader-square:nth-of-type(5) {
            animation-delay: -7.1428571429s;
        }

        .loader-square:nth-of-type(6) {
            animation-delay: -8.5714285714s;
        }

        .loader-square:nth-of-type(7) {
            animation-delay: -10s;
        }
    </style>
</div>