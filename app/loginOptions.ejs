
<div id="loginOptionsContainer" class="hidden fixed inset-0 z-50"  >
    <!-- Overlay sombre -->
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
    
    <!-- Contenu principal -->
    <div id="loginOptionsContent" class="w-full h-screen flex items-center justify-center p-0">
        <!-- Carte principale avec effet glass -->
        <div class="bg-[#181818]/60 backdrop-blur-md border-0 shadow-2xl overflow-hidden w-full h-full">
            
            <div class="grid md:grid-cols-2 gap-0 h-full">
                <!-- Partie gauche : Branding -->
                <div class="p-8 md:p-12 flex flex-col h-full justify-center bg-gradient-to-br from-yellow-600/10 to-orange-600/10 border-r border-gray-700/50">
                    <!-- Logo -->
                    <div class="mb-8">
                        <img src="./assets/images/logoup.png" alt="MultiGames Studio" class="h-16 mb-6">
                        <h1 class="text-3xl font-bold text-white mb-3">
                            <%- lang('loginOptions.loginOptionsTitle') %>
                        </h1>
                        <p class="text-gray-400 text-lg">
                            Connectez-vous pour accéder à MultiGames Studio
                        </p>
                    </div>

                    <!-- Features -->
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 bg-yellow-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-shield-check text-yellow-400"></i>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold text-sm">Connexion sécurisée</h3>
                                <p class="text-gray-400 text-xs">Authentification officielle Microsoft</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-cloud-check text-blue-400"></i>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold text-sm">Synchronisation cloud</h3>
                                <p class="text-gray-400 text-xs">Vos paramètres partout avec vous</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-lightning-charge text-green-400"></i>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold text-sm">Accès rapide</h3>
                                <p class="text-gray-400 text-xs">Lancez vos jeux en un clic</p>
                            </div>
                        </div>
                    </div>

                    <!-- Badge -->
                    <div class="mt-8">
                        <span class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-yellow-500/20 to-orange-500/20 border border-yellow-500/30 text-yellow-400 font-semibold rounded-full text-xs">
                            <i class="bi bi-star-fill"></i>
                            Authentification requise
                        </span>
                    </div>
                </div>

                <!-- Partie droite : Options de connexion -->
                <div class="p-8 md:p-12 flex flex-col justify-center">
                    <div class="space-y-6">
                        <!-- Titre -->
                        <div class="text-center mb-8">
                            <h2 class="text-2xl font-bold text-white mb-2">Choisissez votre méthode</h2>
                            <p class="text-gray-400 text-sm">Sélectionnez comment vous souhaitez vous connecter</p>
                        </div>

                        <!-- Bouton Microsoft -->
                        <button id="loginOptionMicrosoft" style="background-color: rgb(231, 132, 19);" class="group w-full relative overflow-hidden bg-orange-600 hover:orange-500 text-white font-bold py-4 px-6 rounded-xl transition-all duration-300 shadow-lg ">
                            <div class="flex items-center justify-center gap-4">
                                <!-- Logo Microsoft -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 23 23">
                                    <path fill="#f35325" d="M1 1h10v10H1z" />
                                    <path fill="#81bc06" d="M12 1h10v10H12z" />
                                    <path fill="#05a6f0" d="M1 12h10v10H1z" />
                                    <path fill="#ffba08" d="M12 12h10v10H12z" />
                                </svg>
                                <div class="text-left">
                                    <div class="font-bold text-base"><%- lang('loginOptions.loginWithMicrosoft') %></div>
                                    <div class="text-xs text-white/80">Recommandé</div>
                                </div>
                            </div>
                            <!-- Effet brillant au survol -->
                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent transform -skew-x-12 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></div>
                        </button>

                        <!-- Statut de connexion Microsoft -->
                        <div id="loginStatusMicrosoft" class="hidden">
                            <div class="flex items-center justify-center gap-3 p-4 bg-blue-500/10 border border-blue-500/20 rounded-lg">
                                <div class="w-5 h-5 border-2 border-blue-400 border-t-transparent rounded-full animate-spin"></div>
                                <span class="text-blue-300 text-sm font-medium">Connexion en cours...</span>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="relative my-6">
                            <div class="absolute inset-0 flex items-center">
                                <div class="w-full border-t border-gray-700"></div>
                            </div>
                            <div class="relative flex justify-center text-xs">
                                <span class="px-4 bg-[#181818] text-gray-500">ou</span>
                            </div>
                        </div>

                        <!-- Bouton Annuler -->
                        <div id="loginOptionCancelContainer">
                            <button id="loginOptionCancelButton" class="w-full bg-gray-700/50 hover:bg-gray-600/50 text-white py-3 px-6 rounded-lg font-semibold transition-all duration-200 border border-gray-600 hover:border-gray-500">
                                <i class="bi bi-x-circle mr-2"></i>
                                <%- lang('loginOptions.cancelButton') %>
                            </button>
                        </div>

                        <!-- Messages de statut et erreurs -->
                        <div class="space-y-3">
                            <!-- Statut général -->
                            <div id="loginStatus" class="hidden">
                                <div class="flex items-start gap-3 p-4 bg-gray-700/30 border border-gray-600 rounded-lg">
                                    <i class="bi bi-info-circle text-blue-400 text-lg flex-shrink-0 mt-0.5"></i>
                                    <span id="loginStatusText" class="text-gray-300 text-sm">Connexion en cours...</span>
                                </div>
                            </div>

                            <!-- Erreur -->
                            <div id="loginError" class="hidden">
                                <div class="flex items-start gap-3 p-4 bg-red-900/20 border border-red-500/30 rounded-lg">
                                    <i class="bi bi-exclamation-triangle text-red-400 text-lg flex-shrink-0 mt-0.5"></i>
                                    <div class="flex-1">
                                        <div class="font-semibold text-red-300 text-sm mb-1">Erreur de connexion</div>
                                        <span id="loginErrorText" class="text-red-400/90 text-xs">Une erreur est survenue</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Note de sécurité -->
                        <div class="mt-6 p-3 bg-gray-800/30 border border-gray-700/50 rounded-lg">
                            <p class="text-xs text-gray-400 text-center leading-relaxed">
                                <i class="bi bi-shield-lock text-gray-500 mr-1"></i>
                                Vos identifiants sont envoyés directement à Microsoft et ne sont jamais stockés.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>