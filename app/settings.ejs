<div id="settingsContainer" class="hidden " style="display: none;">
  <div class="flex min-h-screen h-screen w-full relative fit-content" style="background: url('./assets/images/backgrounds/0.jpg') center/cover no-repeat;">
    <div class="absolute inset-0 bg-black/60 z-0"></div>
    <main class="relative z-10 flex-1 flex">
    <aside id="settingsContainerLeft" class="w-64 sticky top-0 h-screen ">
      <div class="glass-sidebar bg-[#181818]/60  py-4 px-3 border border-white/10 h-full overflow-y-auto">
      <div id="settingsNavContainer" class="p-3">

        <div id="settingsNavHeader" class="mb-6">
          <span id="settingsNavHeaderText" class="text-lg font-semibold text-white"><%- lang('settings.navHeaderText') %></span>
        </div>
        <div id="settingsNavItemsContainer">
          <div id="settingsNavItemsContent" class="space-y-1">
            <% const navItems = [
              { key: 'settings.navAccount', rSc: 'settingsTabAccount', id: 'settingsNavAccount', selected: true, icon: 'bi-person' },
              { key: 'settings.navMinecraft', rSc: 'settingsTabMinecraft', icon: 'bi-controller' },
              { key: 'settings.navLogs', rSc: 'settingsTabLogs', icon: 'bi-journal-text' },
              { key: 'settings.navMods', rSc: 'settingsTabMods', icon: 'bi-puzzle' },
              { key: 'settings.navJava', rSc: 'settingsTabJava', icon: 'bi-file-code' },
              { key: 'settings.navLauncher', rSc: 'settingsTabLauncher', icon: 'bi-rocket' },
            ]; %>

            <% navItems.forEach(function(item) { %>
              <button class="settingsNavItem w-full text-left text-gray-300 hover:text-white hover:bg-gray-700 py-2 px-3 rounded transition-colors flex items-center" rSc="<%= item.rSc %>"<% if(item.id){ %> id="<%= item.id %>"<% } %><% if(item.selected){ %> selected<% } %>>
                <% if(item.icon){ %>
                  <i class="<%= item.icon %> mr-2 text-current"></i>
                <% } %>
                <span class="flex-1"><%- lang(item.key) %></span>
              </button>
            <% }) %>

            <div class="my-4 border-t border-gray-700"></div>

            <% const bottomItems = [
              { key: 'settings.navAbout', rSc: 'settingsTabAbout', icon: 'bi-info-circle' }
            ]; %>

            <% bottomItems.forEach(function(item) { %>
              <button class="settingsNavItem w-full text-left text-gray-300 hover:text-white hover:bg-gray-700 py-2 px-3 rounded transition-colors flex items-center" rSc="<%= item.rSc %>"<% if(item.id){ %> id="<%= item.id %>"<% } %>>
                <% if(item.icon){ %>
                  <i class="<%= item.icon %> mr-2 text-current"></i>
                <% } %>
                <span class="flex-1"><%- lang(item.key) %></span>
              </button>
            <% }) %>

            <div class="mt-6 pt-4 border-t border-gray-700">
              <button id="settingsNavDone" class="w-full bg-brand-primary hover:bg-brand-light text-white py-2 px-3 rounded transition-colors font-medium">
                <%- lang('settings.navDone') %>
              </button>
            </div>
          </div>
        </div>
      </div>
  </aside>
  <main id="settingsContainerRight" class="flex-1 p-6 glass-main-content overflow-auto max-h-screen">
      <div id="settingsTabAccount" class="settingsTab">
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2"><%- lang('settings.tabAccountHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.tabAccountHeaderDesc') %></p>
        </div>
        <div class="space-y-6">
          <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4">
            <div class="flex justify-between items-center mb-3">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 23 23">
                  <path fill="#f35325" d="M1 1h10v10H1z" />
                  <path fill="#81bc06" d="M12 1h10v10H12z" />
                  <path fill="#05a6f0" d="M1 12h10v10H1z" />
                  <path fill="#ffba08" d="M12 12h10v10H12z" />
                </svg>
                <span class="text-white font-medium"><%- lang('settings.microsoftAccount') %></span>
              </div>
              <button class="bg-brand-primary hover:bg-brand-light text-white py-1 px-3 rounded text-sm transition-colors" id="settingsAddMicrosoftAccount">
                <%- lang('settings.addMicrosoftAccount') %>
              </button>
            </div>
            <div id="settingsCurrentMicrosoftAccounts">
              <!-- Microsoft auth accounts populated here. -->
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabMinecraft" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2"><%- lang('settings.minecraftTabHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.minecraftTabHeaderDesc') %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card: Resolution -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-aspect-ratio text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.gameResolutionTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1">&nbsp;</div>
              <div class="mt-4 flex items-center gap-2">
                <input type="number" id="settingsGameWidth" min="0" cValue="GameWidth" class="w-24 p-2 bg-gray-700 text-white rounded border border-gray-600 focus:border-blue-500">
                <span class="text-white">×</span>
                <input type="number" id="settingsGameHeight" min="0" cValue="GameHeight" class="w-24 p-2 bg-gray-700 text-white rounded border border-gray-600 focus:border-blue-500">
              </div>
            </div>
          </div>

          <!-- Card: Fullscreen -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-arrows-fullscreen text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.launchFullscreenTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1">&nbsp;</div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="Fullscreen" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Card: Auto Connect -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-plug text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.autoConnectTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1">&nbsp;</div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="AutoConnect" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Card: Launch Detached -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-box-arrow-up-right text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.launchDetachedTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1"><%- lang('settings.launchDetachedDesc') %></div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="LaunchDetached" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Card: Show Minecraft Logs -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-journal-text text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.showMinecraftLogsTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1"><%- lang('settings.showMinecraftLogsDesc') %></div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="ShowMinecraftLogs" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabMods" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2"><%- lang('settings.tabModsHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.tabModsHeaderDesc') %></p>
        </div>
        <div class="space-y-6">
          <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4">
            <div class="settingsSelServContent"></div>
            <button class="bg-brand-primary hover:bg-brand-light text-white py-2 px-4 rounded transition-colors mt-3 settingsSwitchServerButton">
              <%- lang('settings.switchServerButton') %>
            </button>
          </div>
          <div id="settingsModsContainer" class="space-y-4">
            <!-- Optional mods: shown as cards for quick scanning -->
            <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.optionalMods') %></h3>
                <span class="text-sm text-gray-400"><%- lang('settings.optionalModsNote') %></span>
              </div>
              <div id="settingsOptModsContent" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </div>

            <!-- Drop-in mods: keep add/remove controls together with a card list -->
            <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.dropinMods') %></h3>
                <div class="flex items-center gap-2">
                  <button id="settingsDropinFileSystemButton" class="bg-brand-primary hover:bg-brand-light text-white py-2 px-4 rounded transition-colors">
                    <%- lang('settings.addMods') %>
                  </button>
                </div>
              </div>
              <p class="text-sm text-gray-400 mb-3"><%- lang('settings.dropinRefreshNote') %></p>
              <div id="settingsDropinModsContent" class="space-y-3"></div>
            </div>

            <!-- Shaderpacks: simple control card -->
            <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.shaderpacks') %></h3>
                <span class="text-sm text-gray-400"><%- lang('settings.shaderpackSummary') %></span>
              </div>
              <p class="text-sm text-gray-400 mb-3"><%- lang('settings.shaderpackDesc') %></p>
              <div class="flex items-center gap-2">
                <button id="settingsShaderpackButton" class="bg-brand-primary hover:bg-brand-light text-white py-2 px-4 rounded transition-colors">+</button>
                <div class="flex-1">
                  <div class="bg-gray-700 text-white py-2 px-4 rounded" id="settingsShadersSelected">
                    <%- lang('settings.selectShaderpack') %>
                  </div>
                  <div class="bg-gray-700 text-white py-2 px-4 rounded mt-2 hidden" id="settingsShadersOptions"></div>
                </div>
              </div>
            </div>

            <!-- Required mods: placed last and shown as a clear list (no toggle to change activation) -->
            <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.requiredMods') %></h3>
                <span class="text-sm text-gray-400"><%- lang('settings.requiredModsNote') %></span>
              </div>
              <p class="text-sm text-gray-400 mb-3"><%- lang('settings.requiredModsDesc') %></p>
              <div id="settingsReqModsContent" class="space-y-3"></div>
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabJava" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2"><%- lang('settings.tabJavaHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.tabJavaHeaderDesc') %></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card: Memory (refactored) - spans two columns on md+ -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group md:col-span-2">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-memory text-white text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.memoryTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.memoryDesc') %></div>

              <!-- Body: ranges -->
              <div class="mt-3 flex-1">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                  <div>
                    <label for="settingsMaxRAMRange" class="text-white font-medium block mb-2"><%- lang('settings.maxRAM') %></label>
                    <div class="flex items-center gap-3">
                      <div id="settingsMaxRAMRange" class="rangeSlider flex-1" cValue="MaxRAM" serverDependent min="3" max="8" value="3" step="0.5">
                        <div class="rangeSliderBar"></div>
                        <div class="rangeSliderTrack"></div>
                      </div>
                      <span id="settingsMaxRAMLabel" class="text-white font-medium w-12 text-right">3G</span>
                    </div>
                  </div>
                  <div>
                    <label for="settingsMinRAMRange" class="text-white font-medium block mb-2"><%- lang('settings.minRAM') %></label>
                    <div class="flex items-center gap-3">
                      <div id="settingsMinRAMRange" class="rangeSlider flex-1" cValue="MinRAM" serverDependent min="3" max="8" value="3" step="0.5">
                        <div class="rangeSliderBar"></div>
                        <div class="rangeSliderTrack"></div>
                      </div>
                      <span id="settingsMinRAMLabel" class="text-white font-medium w-12 text-right">3G</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Footer: memory status (refactored) -->
              <div id="settingsMemoryStatus" class=" rounded-lg p-3 mt-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
                  <div>
                    <div class="text-sm text-gray-400"><%- lang('settings.memoryTotalTitle') %></div>
                    <div class="text-blue-400 text-lg font-semibold" id="settingsMemoryTotal">16G</div>
                  </div>
                  <div>
                    <div class="text-sm text-gray-400"><%- lang('settings.memoryAvailableTitle') %></div>
                    <div class="text-green-400 text-lg font-semibold text-right sm:text-left" id="settingsMemoryAvail">7.3G</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card: Java Executable -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-folder2-open text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.javaExecutableTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1" id="settingsJavaExecDetails"><!-- Invalid Selection --></div>
              <div class="mt-3 flex items-center gap-2">
                <input class="bg-gray-700 text-white rounded p-2 flex-1 border border-gray-600 focus:border-brand-primary" 
                       id="settingsJavaExecVal" type="text" value="null" cValue="JavaExecutable" serverDependent disabled />
                <button class="bg-brand-primary hover:bg-brand-light text-white py-2 px-4 rounded transition-colors" 
                        id="settingsJavaExecSel" dialogTitle="<%- lang('settings.javaExecSelDialogTitle') %>" dialogDirectory="false">
                  <%- lang('settings.javaExecSelButtonText') %>
                </button>
              </div>
              <div class="text-sm text-gray-400 mt-3">
                <%- lang('settings.javaExecDesc') %>
                <strong id="settingsJavaReqDesc"><!-- Requires Java 8 x64. --></strong><br />
                <%- lang('settings.javaPathDesc', {'pathSuffix': `bin${process.platform==='win32' ? '\\javaw.exe' : '/java' }`}) %>
              </div>
            </div>
          </div>

          <!-- Card: JVM Options -->
          <div class="p-4 bg-[#181818]/60 border border-gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-gear text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.jvmOptsTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.jvmOptsDesc') %></div>
              <div class="mt-3">
                <input id="settingsJVMOptsVal" class="bg-gray-700 text-white rounded p-2 flex-1 border border-gray-600 focus:border-blue-500" 
                       cValue="JVMOptions" serverDependent type="text" />
              </div>
              <div class="text-sm text-gray-400 mt-3">
                <a href="#" id="settingsJvmOptsLink" class="text-blue-400 hover:text-blue-300 underline"><!-- Available Options --></a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabLogs" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2"><%- lang('settings.logsTabHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.logsTabHeaderDesc') %></p>
        </div>
      <div class="space-y-6">
        <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4" id="settingsMcLogsWrapper">
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3 mb-3">
              <div class="flex-1">
                <label class="text-white font-medium"><%- lang('settings.mcLogsPanelTitle') %></label>
                <p class="text-sm text-gray-400 mt-1"><%- lang('settings.mcLogsPanelDesc') %></p>
              </div>
              <div class="flex items-center gap-2">
                <button id="settingsMcLogsOpenWindow" class="bg-brand-primary hover:bg-brand-light text-white py-2 px-3 rounded text-sm transition-colors flex items-center gap-2" aria-label="Open logs window" title="<%- lang('settings.mcLogsOpenWindow') %>">
                  <i class="bi bi-window text-current"></i>
                  <span class="sr-only"><%- lang('settings.mcLogsOpenWindow') %></span>
                </button>

                <button id="settingsMcLogsClear" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded text-sm transition-colors flex items-center gap-2" aria-label="Clear logs" title="Clear logs">
                  <i class="bi bi-trash text-current"></i>
                  <span class="hidden sm:inline"><%- lang('settings.mcLogsClear') || 'Clear' %></span>
                </button>

                <button id="settingsMcLogsPause" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded text-sm transition-colors flex items-center gap-2" aria-pressed="false" aria-label="Pause/resume logs" title="Pause/resume logs">
                  <i class="bi bi-pause-fill text-current"></i>
                  <span class="hidden sm:inline">Pause</span>
                </button>

                <button id="settingsMcLogsSave" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded text-sm transition-colors flex items-center gap-2" aria-label="Save logs" title="Save logs">
                  <i class="bi bi-download text-current"></i>
                  <span class="hidden sm:inline">Save</span>
                </button>

                <button id="settingsMcLogsCopy" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded text-sm transition-colors flex items-center gap-2" aria-label="Copy logs" title="Copy logs">
                  <i class="bi bi-clipboard text-current"></i>
                  <span class="hidden sm:inline">Copy</span>
                </button>

                <button id="settingsMcLogsCheck" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded text-sm transition-colors flex items-center gap-2" aria-label="Check buffer" title="Check buffer">
                  <i class="bi bi-check2-square text-current"></i>
                  <span class="hidden sm:inline">Check</span>
                </button>
              </div>
            </div>

            <div class="flex gap-2 items-center mb-3">
              <input id="settingsMcLogsFilter" placeholder="Filter (regex)" class="bg-gray-700 placeholder-gray-400 text-white p-2 rounded text-sm flex-1 border border-gray-600 focus:border-brand-primary" />
              <div id="settingsMcLogsStats" class="text-sm text-gray-400 ml-2 bg-gray-800 px-2 py-1 rounded">0 lines</div>
            </div>

            <div id="settingsMcLogsNote" class="text-sm text-gray-400 mb-2 hidden"></div>
            <div id="settingsMcLogs" class=" text-gray-100 p-3 rounded font-mono text-sm h-96 overflow-auto whitespace-pre-wrap border border-gray-800"></div>
          </div>
        </div>
      </div>
      <div id="settingsTabLauncher" class="settingsTab hidden">
        <div class="settingsTabHeader mb-4">
          <span class="settingsTabHeaderText  text-1xl font-bold text-white"><%- lang('settings.launcherTabHeaderText')
              %></span>
          <span class="settingsTabHeaderDesc text-sm text-gray-400"><%- lang('settings.launcherTabHeaderDesc') %></span>
        </div>
        <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4 mb-4">
          <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
              <div class="text-lg font-semibold text-white"><%- lang('settings.allowPrereleaseTitle') %></div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.allowPrereleaseDesc') %></div>
            </div>
            <div>
              <label class="toggleSwitch">
                <input type="checkbox" cValue="AllowPrerelease" class="hidden">
                <span class="toggleSwitchSlider"></span>
              </label>
            </div>
          </div>
        </div>
        <div class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4 mb-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="text-lg font-semibold text-white" id="settingsDataDirTitle">
                <%- lang('settings.dataDirectoryTitle') %>
              </div>
              <div class="text-sm text-gray-400 mt-1">
                <%- lang('settings.dataDirectoryDesc') %>
              </div>
            </div>

            <div class="settingsFileSelActions flex items-center gap-2 w-full sm:w-auto">
              <i class="bi bi-folder2-open text-current mr-2 hidden sm:inline"></i>
              <input class="settingsFileSelVal bg-gray-700 text-white rounded p-2 flex-grow sm:flex-none sm:w-64" type="text" value="null"
                cValue="DataDirectory" disabled>
              <button class="settingsFileSelButton bg-brand-primary hover:bg-brand-light text-white py-2 px-4 rounded text-sm transition-colors ml-2"
                dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true" title="<%- lang('settings.selectDataDirectory') %>">
                <span><%- lang('settings.chooseFolder') %></span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabAbout" class="settingsTab hidden">
        <div class="settingsTabHeader mb-4">
          <span class="settingsTabHeaderText  text-1xl font-bold text-white"><%- lang('settings.aboutTabHeaderText')
              %></span>
          <span class="settingsTabHeaderDesc text-sm text-gray-400"><%- lang('settings.aboutTabHeaderDesc') %></span>
        </div>
        <div id="settingsAboutCurrentContainer" class="glass-sidebar bg-[#181818]/60 border border-gray-700 rounded-lg p-4 mb-4">
          <div id="settingsAboutCurrentContent">
            <div id="settingsAboutCurrentHeadline" class="flex items-center mb-4">
              <img id="settingsAboutLogo" src="./assets/images/multigames-logo.webp" class="w-12 h-12 mr-4" />
              <span id="settingsAboutTitle" class=" text-1xl font-bold text-white">
                <%- lang('settings.aboutTitle', { appName: lang('app.title') }) %>
              </span>
            </div>
            <div id="settingsAboutCurrentVersion" class="flex items-center mb-4">
