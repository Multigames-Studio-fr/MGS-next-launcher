<div id="settingsContainer" class="hidden fixed inset-0 z-50">
  <div class="flex min-h-screen w-full relative fit-content"  >
    <div class=" "></div>
    <main class="relative z-10 flex-1 flex">
    <aside id="settingsContainerLeft" class="w-64 sticky top-0 h-screen ">
      <div class="glass-sidebar bg-[#181818]/60 py-4 px-3 h-full flex flex-col">
      <div id="settingsNavContainer" class="p-3 overflow-y-auto flex-1">

        <div id="settingsNavHeader" class="mb-6">
          <!-- Sidebar header with logo + small title -->
          <div class="flex items-center gap-3 px-2">
            <img src="./assets/images/multigames-logo.webp" alt="MultiGames Logo" class="w-10 h-10 rounded" />
            <div class="leading-tight">
              <div class="text-white font-[Mojang] font-[Mojang]">MultiGames</div>
              <div class="text-xs font-[Mojang] text-gray-400">Studio</div>
            </div>
          </div>
        </div>
        <div id="settingsNavItemsContainer">
          <div id="settingsNavItemsContent" class="space-y-1">
            <% const navItems = [
              { key: 'settings.navAccount', rSc: 'settingsTabAccount', id: 'settingsNavAccount', selected: true, icon: 'bi-person' },
              { key: 'settings.navMinecraft', rSc: 'settingsTabMinecraft', icon: 'bi-controller' },
              { key: 'settings.navJava', rSc: 'settingsTabJava', icon: 'bi-file-code' },
              { key: 'settings.navMods', rSc: 'settingsTabMods', icon: 'bi-puzzle' },
              { key: 'settings.navLogs', rSc: 'settingsTabLogs', icon: 'bi-journal-text' },
              
            ]; %>

            <% navItems.forEach(function(item) { %>
              <button class="settingsNavItem w-full text-left text-gray-300 hover:text-white hover:bg-gray-700 py-2 px-3 rounded transition-colors flex items-center <% if(item.selected){ %> bg-gradient-to-r from-yellow-600/10 to-transparent  -l-4  -yellow-400 text-white <% } %>" rSc="<%= item.rSc %>"<% if(item.id){ %> id="<%= item.id %>"<% } %><% if(item.selected){ %> selected<% } %>>
                <% if(item.icon){ %>
                  <i class="<%= item.icon %> mr-2 text-current"></i>
                <% } %>
                <span class="flex-1"><%- lang(item.key) %></span>
              </button>
            <% }) %>

            <div class="my-4  -t  -gray-700"></div>

            <% const bottomItems = [
              { key: 'settings.navAbout', rSc: 'settingsTabAbout', icon: 'bi-info-circle' }
            ]; %>

            <% bottomItems.forEach(function(item) { %>
              <button class="settingsNavItem w-full text-left text-gray-300 hover:text-white hover:bg-gray-700 py-2 px-3 rounded transition-colors flex items-center" rSc="<%= item.rSc %>"<% if(item.id){ %> id="<%= item.id %>"<% } %>>
                <% if(item.icon){ %>
                  <i class="<%= item.icon %> mr-2 text-current"></i>
                <% } %>
                <span class="flex-1"><%- lang(item.key) %></span>
              </button>
            <% }) %>


          </div>
        </div>
      </div>

      <!-- Sidebar footer -->
      <div class="px-3 py-4 mt-auto">
                    <div class="mt-6 pt-4  -t  -gray-700">
              <button id="settingsNavDone" class="w-full bg-[#FF6A1A] hover:bg-[#F8BA59] text-white py-2 px-3 rounded transition-colors font-medium">
                <%- lang('settings.navDone') %>
              </button>
            </div>
            <br>
        <div class="text-center text-xs text-gray-500">made by <a href="https://wiltark.fr" target="_blank" rel="noopener noreferrer">wiltark</a></div>
      </div>

  </aside>
  <main id="settingsContainerRight" class="flex-1 p-6 glass-main-content overflow-auto max-h-screen">
      <div id="settingsTabAccount" class="settingsTab">
        <div class="mb-6">
          <h2 class="text-xl text-white mb-2 font-[Mojang]"><%- lang('settings.tabAccountHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.tabAccountHeaderDesc') %></p>
        </div>
        <div class="space-y-6">
          <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg p-4">
            <div class="flex justify-between items-center mb-3">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 23 23">
                  <path fill="#f35325" d="M1 1h10v10H1z" />
                  <path fill="#81bc06" d="M12 1h10v10H12z" />
                  <path fill="#05a6f0" d="M1 12h10v10H1z" />
                  <path fill="#ffba08" d="M12 12h10v10H12z" />
                </svg>
                <span class="text-white font-medium"><%- lang('settings.microsoftAccount') %></span>
              </div>
              <button class="bg-[#FF6A1A] hover:bg-[#F8BA59] text-white py-1 px-3 rounded text-sm transition-colors" id="settingsAddMicrosoftAccount">
                <%- lang('settings.addMicrosoftAccount') %>
              </button>
            </div>
            <div id="settingsCurrentMicrosoftAccounts">
              <!-- Microsoft auth accounts populated here. -->
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabMinecraft" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-[Mojang] text-white mb-2"><%- lang('settings.minecraftTabHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.minecraftTabHeaderDesc') %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card: Resolution -->
          <div class="glass-sidebar p-4    -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-aspect-ratio text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.gameResolutionTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.gameResolutionDesc') %></div>
              <div class="mt-4 flex items-center gap-2">
                <input type="number" id="settingsGameWidth" min="0" cValue="GameWidth" class="w-24 p-2 bg-gray-700 text-white rounded    -gray-600 focus: -blue-500">
                <span class="text-white">×</span>
                <input type="number" id="settingsGameHeight" min="0" cValue="GameHeight" class="w-24 p-2 bg-gray-700 text-white rounded    -gray-600 focus: -blue-500">
              </div>
            </div>
          </div>

          <!-- Card: Fullscreen -->
          <div class="glass-sidebar p-4    -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-arrows-fullscreen text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.launchFullscreenTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1"><%- lang('settings.launchFullscreenDesc') %></div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="Fullscreen" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Card: Auto Connect -->
          <div class="glass-sidebar p-4    -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-plug text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.autoConnectTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1"><%- lang('settings.autoConnectDesc') %></div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="AutoConnect" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Card: Launch Detached -->
          <div class="glass-sidebar p-4    -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-box-arrow-up-right text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.launchDetachedTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1"><%- lang('settings.launchDetachedDesc') %></div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="LaunchDetached" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Card: Show Minecraft Logs -->
          <div class="glass-sidebar p-4    -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-journal-text text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.showMinecraftLogsTitle') %></div>
              </div>
              <div class="text-sm group-hover:text-white text-gray-400 mt-1"><%- lang('settings.showMinecraftLogsDesc') %></div>
              <div class="mt-4 flex justify-end">
                <label class="toggleSwitch">
                  <input type="checkbox" cValue="ShowMinecraftLogs" class="hidden">
                  <span class="toggleSwitchSlider"></span>
                </label>
              </div>
            </div>
          </div>
                 
        <div class="glass-sidebar p-4 mb-4    -gray-700 rounded-lg">
          <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
              <div class="text-lg  text-white"><%- lang('settings.allowPrereleaseTitle') %></div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.allowPrereleaseDesc') %></div>
            </div>
            <div>
              <label class="toggleSwitch">
                <input type="checkbox" cValue="AllowPrerelease" class="hidden">
                <span class="toggleSwitchSlider"></span>
              </label>
            </div>
          </div>
        </div>
        <div class="glass-sidebar p-4 mb-4 md:col-span-2    -gray-700 rounded-lg">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="text-lg text-white" id="settingsDataDirTitle">
                <%- lang('settings.dataDirectoryTitle') %>
              </div>
              <div class="text-sm text-gray-400 mt-1">
                <%- lang('settings.dataDirectoryDesc') %>
              </div>
            </div>

            <div class="settingsFileSelActions flex items-center gap-2 w-full sm:w-auto">
              <i class="bi bi-folder2-open text-current mr-2 hidden sm:inline"></i>
              <input class="settingsFileSelVal bg-gray-700 text-white rounded p-2 flex-grow sm:flex-none sm:w-64" type="text" value="null"
                cValue="DataDirectory" disabled>
              <button class="settingsFileSelButton bg-[#FF6A1A] hover:bg-[#F8BA59] text-white py-2 px-4 rounded text-sm transition-colors ml-2"
                dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true" title="<%- lang('settings.selectDataDirectory') %>">
                <span><%- lang('settings.chooseFolder') %></span>
              </button>
            </div>
          </div>
        </div>
        </div>
      </div>
      <div id="settingsTabMods" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-[Mojang] text-white mb-2"><%- lang('settings.tabModsHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.tabModsHeaderDesc') %></p>
        </div>
        <div class="space-y-6">

          <div id="settingsModsContainer" class="space-y-4">
            <!-- Optional mods: shown as cards for quick scanning -->
            <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.optionalMods') %></h3>
                <span class="text-sm text-gray-400"><%- lang('settings.optionalModsNote') %></span>
              </div>
              <div id="settingsOptModsContent" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </div>

            <!-- Shaderpacks: simple control card -->
            <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.shaderpacks') %></h3>
                <span class="text-sm text-gray-400"><%- lang('settings.shaderpackSummary') %></span>
              </div>
              <p class="text-sm text-gray-400 mb-3"><%- lang('settings.shaderpackDesc') %></p>
              <div class="flex items-center gap-2">
                <button id="settingsShaderpackButton" class="bg-[#FF6A1A] hover:bg-[#F8BA59] text-white py-2 px-4 rounded transition-colors">+</button>
                <div class="flex-1">
                  <div class="bg-gray-700 text-white py-2 px-4 rounded" id="settingsShadersSelected">
                    <%- lang('settings.selectShaderpack') %>
                  </div>
                  <div class="bg-gray-700 text-white py-2 px-4 rounded mt-2 hidden" id="settingsShadersOptions"></div>
                </div>
              </div>
            </div>

            <!-- Required mods: placed last and shown as a clear list (no toggle to change activation) -->
            <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.requiredMods') %></h3>
                <span class="text-sm text-gray-400"><%- lang('settings.requiredModsNote') %></span>
              </div>
              <p class="text-sm text-gray-400 mb-3"><%- lang('settings.requiredModsDesc') %></p>
              <div id="settingsReqModsContent" class="space-y-3"></div>
            </div>
            
            <!-- Force Download Check: button to verify mods -->
            <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <h3 class="text-white font-medium mb-1"><%- lang('settings.forceDownloadTitle') || 'Vérifier les mods' %></h3>
                  <p class="text-sm text-gray-400"><%- lang('settings.forceDownloadDesc') || 'Force la vérification et le téléchargement des mods avant le lancement' %></p>
                </div>
                <button id="settingsForceDownloadButton" class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded transition-colors whitespace-nowrap ml-4">
                  <%- lang('settings.forceDownloadButton') || 'Vérifier' %>
                </button>
              </div>
            </div>
            
            <!-- Drop-in mods: keep add/remove controls together with a card list -->
            <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium"><%- lang('settings.dropinMods') %></h3>
                <div class="flex items-center gap-2">
                  <button id="settingsDropinFileSystemButton" class="bg-[#FF6A1A] hover:bg-[#F8BA59] text-white py-2 px-4 rounded transition-colors">
                    <%- lang('settings.addMods') %>
                  </button>
                </div>
              </div>
              <p class="text-sm text-gray-400 mb-3"><%- lang('settings.dropinRefreshNote') %></p>
              <div id="settingsDropinModsContent" class="space-y-3"></div>
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabJava" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-[Mojang] text-white mb-2"><%- lang('settings.tabJavaHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.tabJavaHeaderDesc') %></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

          <!-- Card: Memory (refactored) - accessible range inputs, spans two columns on md+ -->
          <div class="p-4 bg-[#181818]/60  glass-sidebar   -gray-700 rounded-lg group md:col-span-2">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-memory text-white text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.memoryTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.memoryDesc') %></div>

              <!-- Body: ranges (semantic inputs for accessibility) -->
              <div class="mt-3 flex-1">
                <!-- Double-range visual: two overlapping range inputs with a highlighted fill between thumbs -->
                <div class="mt-2">
                  <div class="mb-2 flex items-center justify-between">
                    <label for="settingsMinRAMRange" class="text-white font-medium"><%- lang('settings.minRAM') %></label>
                    <label for="settingsMaxRAMRange" class="text-white font-medium"><%- lang('settings.maxRAM') %></label>
                  </div>
                  <div class="relative w-full range-double-container h-8">
                    <!-- Hidden native inputs for accessibility and persistence -->
                    <input id="settingsMaxRAMRange" class="sr-only" style="position:absolute;opacity:0;pointer-events:none;" cValue="MaxRAM" serverDependent type="range" min="3" max="8" step="0.5" value="3" aria-label="Max RAM (GB)">
                    <input id="settingsMinRAMRange" class="sr-only" style="position:absolute;opacity:0;pointer-events:none;" cValue="MinRAM" serverDependent type="range" min="3" max="8" step="0.5" value="3" aria-label="Min RAM (GB)">

                    <!-- Custom visual track + thumbs -->
                    <div class="double-range-track absolute inset-0 flex items-center">
                      <div class="double-range-track-bg absolute left-0 right-0 h-2 rounded bg-[rgba(255,255,255,0.06)]"></div>
                      <div id="settingsRangeFill" class="range-fill pointer-events-none absolute h-2 rounded"></div>
                      <button id="settingsMinThumb" class="double-range-thumb min-thumb" aria-label="Min RAM thumb" type="button"></button>
                      <button id="settingsMaxThumb" class="double-range-thumb max-thumb" aria-label="Max RAM thumb" type="button"></button>
                    </div>
                  </div>
                  <div class="mt-2 flex items-center justify-between">
                    <span id="settingsMinRAMLabel" class="text-white font-medium">3G</span>
                    <span id="settingsMaxRAMLabel" class="text-white font-medium">3G</span>
                  </div>
                </div>
              </div>

             
            </div>
          </div>

          <!-- Card: Java Executable -->
          <div class="p-4 bg-[#181818]/60  glass-sidebar  -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-folder2-open text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.javaExecutableTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1" id="settingsJavaExecDetails"><!-- Invalid Selection --></div>
              <div class="mt-3 flex items-center gap-2">
                <input class="bg-gray-700 text-white rounded p-2 flex-1    -gray-600 focus: -brand-primary" 
                       id="settingsJavaExecVal" type="text" value="null" cValue="JavaExecutable" serverDependent disabled />
                <button class="bg-[#FF6A1A] hover:bg-[#F8BA59] text-white py-2 px-4 rounded transition-colors" 
                        id="settingsJavaExecSel" dialogTitle="<%- lang('settings.javaExecSelDialogTitle') %>" dialogDirectory="false">
                  <%- lang('settings.javaExecSelButtonText') %>
                </button>
              </div>
              <div class="text-sm text-gray-400 mt-3">
                <%- lang('settings.javaExecDesc') %>
                <strong id="settingsJavaReqDesc"><!-- Requires Java 8 x64. --></strong><br />
                <%- lang('settings.javaPathDesc', {'pathSuffix': `bin${process.platform==='win32' ? '\\javaw.exe' : '/java' }`}) %>
              </div>
            </div>
          </div>

          <!-- Card: JVM Options -->
          <div class="p-4 bg-[#181818]/60  glass-sidebar  -gray-700 rounded-lg group">
            <div class="flex flex-col">
              <div class="flex items-baseline gap-2">
                <i class="bi bi-gear text-white  text-1xl"></i>
                <div class="text-white font-medium"><%- lang('settings.jvmOptsTitle') %></div>
              </div>
              <div class="text-sm text-gray-400 mt-1"><%- lang('settings.jvmOptsDesc') %></div>
              <div class="mt-3 flex items-center gap-2">
                <input id="settingsJVMOptsVal" class="bg-gray-700 text-white rounded p-2 flex-1    -gray-600 focus: -blue-500" 
                       cValue="JVMOptions" serverDependent type="text" />
              </div>
              <div class="text-sm text-gray-400 mt-3">
                <a href="#" id="settingsJvmOptsLink" class="text-blue-400 hover:text-blue-300 underline"><!-- Available Options --></a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="settingsTabLogs" class="settingsTab hidden">
        <div class="mb-6">
          <h2 class="text-xl font-[Mojang] text-white mb-2"><%- lang('settings.logsTabHeaderText') %></h2>
          <p class="text-sm text-gray-400"><%- lang('settings.logsTabHeaderDesc') %></p>
        </div>
        
        <div class="space-y-6">
          <!-- Minecraft Logs Panel -->
          <div class="glass-sidebar bg-[#181818]/60    -gray-700 rounded-lg overflow-hidden" id="settingsMcLogsWrapper">

            <!-- Logs Content Section -->
            <div class="p-4">
              <div id="settingsMcLogsNote" class="text-sm text-blue-400 bg-blue-400/10    -blue-400/20 rounded-lg p-3 mb-3 hidden items-start gap-2">
                <i class="bi bi-info-circle mt-0.5 flex-shrink-0"></i>
                <span class="flex-1"></span>
              </div>
              
              <div class="relative">
                <div id="settingsMcLogs" class="bg-gray-900/80 text-gray-100 p-4 rounded-lg font-mono text-xs leading-relaxed h-[32rem] overflow-auto    -gray-700 shadow-inner whitespace-pre-wrap break-words">
                  <!-- Logs will be populated here -->
                </div>
                <!-- Scrollbar & Log styling -->
                <style>
                  #settingsMcLogs::-webkit-scrollbar {
                      width: 8px;
                      height: 8px;
                    }
                    #settingsMcLogs::-webkit-scrollbar-track {
                      background: rgba(45,55,72,0.12);
                      border-radius: 999px;
                    }
                    #settingsMcLogs::-webkit-scrollbar-thumb {
                      background: rgba(74,85,104,0.6);
                      border-radius: 999px;
                      border: 2px solid transparent;
                      background-clip: padding-box;
                    }
                    #settingsMcLogs::-webkit-scrollbar-thumb:hover {
                      background: rgba(113,128,150,0.75);
                    }

                    /* Firefox for the logs pane */
                    #settingsMcLogs { scrollbar-width: thin; scrollbar-color: rgba(74,85,104,0.6) rgba(45,55,72,0.12); }

                  /* Log level coloring */
                  .log-line { 
                    display: block; 
                    padding: 2px 0;
                    line-height: 1.5;
                  }
                  .log-line:hover {
                    background: rgba(59, 130, 246, 0.1);
                  }
                  .log-timestamp { 
                    color: #94a3b8; 
                    opacity: 0.7;
                  }
                  .log-thread { 
                    color: #60a5fa;
                    font-weight: 500;
                  }
                  .log-level-INFO { 
                    color: #10b981;
                    font-weight: 600;
                  }
                  .log-level-WARN { 
                    color: #f59e0b;
                    font-weight: 600;
                  }
                  .log-level-ERROR { 
                    color: #ef4444;
                    font-weight: 700;
                  }
                  .log-level-DEBUG { 
                    color: #8b5cf6;
                    font-weight: 500;
                  }
                  .log-level-TRACE { 
                    color: #6b7280;
                    font-weight: 400;
                  }
                  .log-source { 
                    color: #cbd5e1;
                  }
                  .log-message { 
                    color: #e2e8f0;
                  }
                  .log-empty-state {
                    color: #6b7280;
                    text-align: center;
                    padding: 3rem 1rem;
                  }
                  .log-empty-state i {
                    font-size: 3rem;
                    opacity: 0.5;
                    display: block;
                    margin-bottom: 1rem;
                  }
                </style>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="settingsTabAbout" class="settingsTab hidden">
        <div class="settingsTabHeader mb-4">
          <span class="settingsTabHeaderText  text-1xl font-bold text-white"><%- lang('settings.aboutTabHeaderText')
              %></span><br />
          <span class="settingsTabHeaderDesc text-sm text-gray-400"><%- lang('settings.aboutTabHeaderDesc') %></span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div id="settingsAboutCurrentContainer" class="glass-sidebar p-4 mb-4    -gray-700 rounded-lg">
          <div id="settingsAboutCurrentContent">
