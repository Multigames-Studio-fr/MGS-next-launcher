<style>
  /* Theme base overrides for settings page (glass + accents) */
  .glass-sidebar {
    background-color: rgba(24,24,24,0.6) !important;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);


    border: 1px solid rgba(255,255,255,0.04);
  }

  /* Selected nav item (uses attribute [selected] from template) */
  .settingsNavItem[selected], .settingsNavItem.selected {
    background: linear-gradient(90deg, rgba(245,158,11,0.06), transparent 60%);
    border-left: 4px solid #f59e0b; /* amber-400 */
    color: #fff !important;
  }

  /* Cards and main content styling */
  .glass-main-content > .settingsTab .glass-sidebar,
  .glass-main-content .glass-sidebar {
    box-shadow: 0 8px 24px rgba(0,0,0,0.55);
     
  }

  /* Accent for primary buttons (blue) to match screenshot */
  .bg-brand-primary { background-color: #0ea5e9 !important; }
  .hover\:bg-brand-light:hover { background-color: #38bdf8 !important; }

  /* Headings accent (gold/orange) */
  .settings-accent-gold { color: #f59e0b; }

  /* Simplified RAM slider */
  .ram-slider-container { 
    position: relative; 
  }
  .ram-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 6px;
    border-radius: 999px;
    background: rgba(255,255,255,0.1);
  }
  .ram-fill {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, #FF6A1A, #F8BA59);
  }
  .ram-thumb {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #FF6A1A;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    cursor: grab;
    z-index: 10;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .ram-thumb:hover {
    transform: translate(-50%, -50%) scale(1.2);
    box-shadow: 0 3px 12px rgba(255,106,26,0.4);
    border-color: #F8BA59;
  }
  .ram-thumb:active, .ram-thumb.dragging {
    cursor: grabbing;
    transform: translate(-50%, -50%) scale(1.25);
    border-color: #F8BA59;
  }

  /* Settings tab transition animations */
  .settingsTab {
    opacity: 1;
    transform: translateY(0);
  }
  .settingsTab.hidden {
    opacity: 0;
    display: none !important;
  }
  .settingsTab.tab-entering {
    animation: settingsTabFadeIn 0.2s ease-out forwards;
  }
  @keyframes settingsTabFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .settingsTab.tab-exit {
    animation: settingsTabFadeOut 0.15s ease-in forwards;
  }
  @keyframes settingsTabFadeOut {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* Nav item hover animation */
  .settingsNavItem {
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  /* Force animations even with reduced motion preference */
  #settingsContainer,
  #settingsContainer *,
  #settingsContainer *::before,
  #settingsContainer *::after {
    animation-duration: 0.2s !important;
    transition-duration: 0.15s !important;
  }
</style>