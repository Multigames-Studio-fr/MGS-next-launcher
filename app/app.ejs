<html lang="en" xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy"
        content="script-src 'self' 'unsafe-inline'; object-src 'self'; worker-src 'self' blob: data:;" />
    <title>
        <%= lang('app.title') %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&display=swap" rel="stylesheet">
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/init-news-stub.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/tailwind-compiled.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher2.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: "Sora", serif;
            font-optical-sizing: auto;

        background-image: linear-gradient(to bottom, rgba(0,0,0,0.65), rgba(0,0,0,0.18)), url('assets/images/backgrounds/<%=bkid%>.jpg');
        background-repeat: no-repeat;
        background-position: center center;
        background-attachment: fixed;
        background-size: cover;
        }
        @import url('http://multigames-studio.fr/font/fs-mojang-studios-2.otf');
        @font-face {
            font-family: 'Mojang';
            src: url('http://multigames-studio.fr/font/fs-mojang-studios-2.otf') format('opentype');
            font-weight: normal;
            font-style: normal;
        }   
        .font-mojang {
            font-family: 'Mojang', sans-serif;
            font-weight: 41px;
            font-style: normal;
            font-variant: normal;
            text-transform: none;
            line-height: 1;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            width: 100%;
            position: absolute;

        }



        .launch-progress {
            width: 100%;
            height: 2rem;
            background-color: #4a5568;
            /* Tailwind CSS bg-gray-700 */
            border-radius: 0.25rem;
            /* Tailwind CSS rounded */
            transition: width 0.5s ease-in-out;
            position: relative;
            z-index: 1;
        }

        .launch-progress::-webkit-progress-bar {
            background-color: #4a5568;
            /* Tailwind CSS bg-gray-700 */
            border-radius: 0.25rem;
            /* Tailwind CSS rounded */
        }

        .launch-progress::-webkit-progress-value {
            background-color: #3182ce;
            /* Tailwind CSS bg-blue-600 */
            border-radius: 0.25rem;
            /* Tailwind CSS rounded */
            transition: width 0.5s ease-in-out;
        }

        .launch-progress::-moz-progress-bar {
            background-color: #3182ce;
            /* Tailwind CSS bg-blue-600 */
            border-radius: 0.25rem;
            /* Tailwind CSS rounded */
            transition: width 0.5s ease-in-out;
        }

        .progress-text {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
            color: white;
        }

        /* Custom thin scrollbar (WebKit + Firefox) */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(45,55,72,0.12);
            border-radius: 999px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(74,85,104,0.6);
            border-radius: 999px;
            border: 2px solid transparent; /* gives padding effect */
            background-clip: padding-box;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(113,128,150,0.75);
        }

        ::-webkit-scrollbar-thumb:active {
            background: rgba(160,174,192,0.95);
        }

        /* Firefox */
        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(74,85,104,0.6) rgba(45,55,72,0.12);
        }
        /* --- Sidebar / label animation helpers (shared) --- */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideRight {
            from { opacity: 0; transform: translateX(18px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes popIn {
            from { opacity: 0; transform: scale(.96) translateY(4px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .animate-fade { animation: fadeUp 520ms cubic-bezier(.2,.9,.2,1) both; }
        .animate-slide-right { animation: slideRight 420ms cubic-bezier(.2,.9,.2,1) both; }
        .animated-pop { animation: popIn 420ms cubic-bezier(.2,.9,.2,1) both; }

        /* Server label reveal helpers (used by landing sidebar) */
        .server-instance-label {
            display: inline-block !important;
            opacity: 0;
            transform: translateX(-6px);
            max-width: 0;
            transition: opacity 220ms linear, transform 260ms cubic-bezier(.2,.9,.2,1), max-width 260ms cubic-bezier(.2,.9,.2,1);
            white-space: nowrap;
            vertical-align: middle;
            pointer-events: none;
        }
        .server-instance-label.block {
            opacity: 1;
            transform: translateX(0);
            max-width: 160px;
            pointer-events: auto;
        }
        .server-instance-label.hidden {
            opacity: 0;
            transform: translateX(-6px);
            max-width: 0;
            pointer-events: none;
        }

        /* Fixed width for player info block to avoid layout shift */
        .player-top-info { min-width: 12.5rem; max-width: 12.5rem; box-sizing: border-box; }

        /* ======================================================
           User-requested: disable all animations/transitions
           This forces animations and transitions to be inert
           across the app while keeping the rest of styles.
           ====================================================== */
        *,
        *::before,
        *::after {
            animation-name: none !important;
            animation-duration: 0s !important;
            animation-delay: 0s !important;
            transition: none !important;
            scroll-behavior: auto !important;
        }
    </style>
</head>

<body class="dark " bkid="<%=bkid%>">
    
    <div id="main">
         
        <%- include('frame') %>
        <%- include('welcome') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
    <%- include('news') %>
        <%- include('landing') %>
       
    </div>
    <%- include('overlay') %>
    <!-- Fullscreen intro overlay -->
    <div id="introOverlay" class="fixed inset-0 z-50  flex items-center justify-center" style="opacity:1;">
        <video id="introVideo" class="absolute inset-0 w-full h-full object-cover z-10" playsinline autoplay preload="auto" poster="">
            <source src="https://multigames-studio.fr/MultigamesStudio16-6-25.mp4" type="video/mp4">
            Votre navigateur ne supporte pas la vidéo.
        </video>
       
        <!-- Optional separate audio track for the intro. Browsers may require a user gesture to unmute/play. -->
        <audio id="introAudio" preload="auto" style="display:none">
            <!-- Add a source here if you want a separate audio track, e.g. <source src="/assets/audio/intro.mp3" type="audio/mpeg"> -->
        </audio>
         <button id="skipIntroBtn" aria-label="Skip intro" title="Skip intro" class="absolute bottom-4 right-4 z-50 bg-gray-800 text-white px-3 py-1 rounded opacity-80 hover:opacity-100">Skip</button>
    </div>

    <script src="./assets/js/scripts/intro.js"></script>
</body>

</html>